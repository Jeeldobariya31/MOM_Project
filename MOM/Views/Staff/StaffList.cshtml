@model System.Data.DataTable

@{
    ViewData["Title"] = "Staff List";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var departmentFilter = ViewBag.DepartmentFilter as string ?? "";
    var sortBy = ViewBag.SortBy as string ?? "StaffName";
    var sortOrder = ViewBag.SortOrder as string ?? "asc";
    var totalRecords = ViewBag.TotalRecords as int? ?? 0;
    var filteredRecords = ViewBag.FilteredRecords as int? ?? 0;
    var departments = ViewBag.Departments as List<dynamic> ?? new List<dynamic>();
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-people me-2"></i>Staff Management</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="breadcrumb-item">Master</li>
                    <li class="breadcrumb-item active">Staff</li>
                </ol>
            </nav>
        </div>
        <a asp-action="StaffAddEdit" class="btn btn-light">
            <i class="bi bi-plus-lg me-1"></i>
            Add Staff Member
        </a>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-hover">
                <div class="card-body">
                    <!-- Header with Stats -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h5 class="card-title mb-1">
                                <i class="bi bi-people text-primary me-2"></i>
                                Staff Management
                            </h5>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Showing @filteredRecords of @totalRecords staff members
                            </p>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="modernUI.exportTable('#staffTable', 'staff', 'csv')">
                                <i class="bi bi-file-earmark-excel me-1"></i>
                                Export
                            </button>
                            <a asp-action="StaffAddEdit" class="btn btn-primary">
                                <i class="bi bi-plus-lg me-1"></i>
                                Add Staff Member
                            </a>
                        </div>
                    </div>

                    <!-- Search and Filter Section -->
                    <div class="filter-section">
                        <form method="get" class="row g-3">
                            <input type="hidden" name="sortBy" value="@sortBy" />
                            <input type="hidden" name="sortOrder" value="@sortOrder" />
                            
                            <div class="col-md-6">
                                <label class="form-label">Search Staff</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text" 
                                           name="searchTerm" 
                                           value="@searchTerm" 
                                           class="form-control" 
                                           placeholder="Search by name, email, or mobile..." />
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-search me-1"></i>Search
                                    </button>
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <label class="form-label">Department Filter</label>
                                <select name="departmentFilter" class="form-select" onchange="this.form.submit()">
                                    <option value="">All Departments</option>
                                    @foreach (var dept in departments)
                                    {
                                        <option value="@dept.Value" selected="@(departmentFilter == dept.Value.ToString())">
                                            @dept.Text
                                        </option>
                                    }
                                </select>
                            </div>
                            
                            <div class="col-md-2 d-flex align-items-end">
                                @if (!string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(departmentFilter))
                                {
                                    <a href="@Url.Action("StaffList")" class="btn btn-outline-secondary w-100">
                                        <i class="bi bi-x-lg me-1"></i>Clear
                                    </a>
                                }
                            </div>
                        </form>
                    </div>

                    <!-- Data Table -->
                    <div class="table-container">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle" id="staffTable">
                                <thead>
                                    <tr>
                                        <th>
                                            <a href="@Url.Action("StaffList", new { searchTerm, departmentFilter, sortBy = "StaffName", sortOrder = (sortBy == "StaffName" && sortOrder == "asc") ? "desc" : "asc" })" 
                                               class="text-decoration-none text-dark d-flex align-items-center">
                                                Staff Name
                                                @if (sortBy == "StaffName")
                                                {
                                                    <i class="bi bi-arrow-@(sortOrder == "asc" ? "up" : "down") ms-1"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>Department</th>
                                        <th>Contact Information</th>
                                        <th>
                                            <a href="@Url.Action("StaffList", new { searchTerm, departmentFilter, sortBy = "Created", sortOrder = (sortBy == "Created" && sortOrder == "asc") ? "desc" : "asc" })" 
                                               class="text-decoration-none text-dark d-flex align-items-center">
                                                Created Date
                                                @if (sortBy == "Created")
                                                {
                                                    <i class="bi bi-arrow-@(sortOrder == "asc" ? "up" : "down") ms-1"></i>
                                                }
                                            </a>
                                        </th>
                                        <th class="text-center" style="width: 200px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Rows.Count > 0)
                                    {
                                        @foreach (System.Data.DataRow row in Model.Rows)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar bg-primary me-3">
                                                            <i class="bi bi-person"></i>
                                                        </div>
                                                        <div>
                                                            <h6 class="mb-0 fw-semibold">@row["StaffName"]</h6>
                                                            <small class="text-muted">ID: @row["StaffID"]</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-info">
                                                        @row["DepartmentName"]
                                                    </span>
                                                </td>
                                                <td>
                                                    <div>
                                                        <i class="bi bi-envelope me-1 text-muted"></i>
                                                        <small>@row["EmailAddress"]</small>
                                                    </div>
                                                    <div>
                                                        <i class="bi bi-phone me-1 text-muted"></i>
                                                        <small>@row["MobileNo"]</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div>
                                                        <span class="fw-medium">
                                                            @Convert.ToDateTime(row["Created"]).ToString("dd MMM yyyy")
                                                        </span>
                                                        <br>
                                                        <small class="text-muted">
                                                            @Convert.ToDateTime(row["Created"]).ToString("hh:mm tt")
                                                        </small>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group" role="group">
                                                        <button type="button" 
                                                                class="btn btn-outline-info btn-sm" 
                                                                onclick="viewStaff(@row["StaffID"])"
                                                                title="View Details">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <a asp-action="StaffAddEdit" 
                                                           asp-route-id="@row["StaffID"]"
                                                           class="btn btn-outline-primary btn-sm"
                                                           title="Edit">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                        <button type="button" 
                                                                class="btn btn-outline-danger btn-sm" 
                                                                onclick="deleteStaff(@row["StaffID"], '@row["StaffName"]')"
                                                                title="Delete">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5">
                                                <div class="empty-state">
                                                    <i class="bi bi-people"></i>
                                                    @if (!string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(departmentFilter))
                                                    {
                                                        <h3>No staff members found</h3>
                                                        <p>No staff members match your search criteria</p>
                                                        <a href="@Url.Action("StaffList")" class="btn btn-outline-primary">
                                                            <i class="bi bi-arrow-left me-1"></i>Clear Filters
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <h3>No staff members yet</h3>
                                                        <p>Get started by adding your first staff member</p>
                                                        <a asp-action="StaffAddEdit" class="btn btn-primary">
                                                            <i class="bi bi-plus-lg me-1"></i>Add First Staff Member
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function viewStaff(id) {
            const button = document.querySelector(`button[onclick="viewStaff(${id})"]`);
            if (button) {
                modernUI.setButtonLoading(button, 'Loading...');
            }
            
            fetch(`/Staff/GetStaffDetails/${id}`)
                .then(response => response.json())
                .then(data => {
                    if (button) {
                        modernUI.resetButton(button);
                    }
                    
                    if (data.success) {
                        const staff = data.data;
                        modernUI.showModal({
                            title: `<i class="bi bi-person me-2"></i>Staff Details`,
                            size: 'lg',
                            content: `
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title text-primary mb-3">
                                                    <i class="bi bi-person-badge me-1"></i>Personal Information
                                                </h6>
                                                <div class="row mb-2">
                                                    <div class="col-sm-4"><strong>Staff ID:</strong></div>
                                                    <div class="col-sm-8">${modernUI.safeValue(staff.StaffID)}</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-4"><strong>Name:</strong></div>
                                                    <div class="col-sm-8">${modernUI.safeValue(staff.StaffName)}</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-4"><strong>Department:</strong></div>
                                                    <div class="col-sm-8"><span class="badge bg-info">${modernUI.safeValue(staff.DepartmentName)}</span></div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-4"><strong>Email:</strong></div>
                                                    <div class="col-sm-8">
                                                        ${staff.EmailAddress ? `<a href="mailto:${staff.EmailAddress}">${staff.EmailAddress}</a>` : 'N/A'}
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-4"><strong>Mobile:</strong></div>
                                                    <div class="col-sm-8">
                                                        ${staff.MobileNo ? `<a href="tel:${staff.MobileNo}">${staff.MobileNo}</a>` : 'N/A'}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title text-success mb-3">
                                                    <i class="bi bi-info-circle me-1"></i>Additional Information
                                                </h6>
                                                <div class="row mb-2">
                                                    <div class="col-sm-4"><strong>Meetings:</strong></div>
                                                    <div class="col-sm-8"><span class="badge bg-success">${modernUI.safeValue(staff.MeetingCount, '0')}</span></div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-4"><strong>Remarks:</strong></div>
                                                    <div class="col-sm-8">${modernUI.safeValue(staff.Remarks, 'No remarks')}</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-4"><strong>Created:</strong></div>
                                                    <div class="col-sm-8">${modernUI.formatDate(staff.Created)}</div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-4"><strong>Modified:</strong></div>
                                                    <div class="col-sm-8">${modernUI.formatDate(staff.Modified)}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `,
                            buttons: [
                                {
                                    text: 'Edit Staff',
                                    class: 'btn-primary',
                                    icon: 'bi bi-pencil',
                                    onclick: `window.location.href='/Staff/StaffAddEdit/${id}'`
                                },
                                {
                                    text: 'Close',
                                    class: 'btn-secondary',
                                    onclick: 'modernUI.closeModal()'
                                }
                            ]
                        });
                    } else {
                        modernUI.showToast({
                            title: 'Error',
                            message: data.message || 'Failed to load staff details',
                            type: 'error'
                        });
                    }
                })
                .catch(error => {
                    if (button) {
                        modernUI.resetButton(button);
                    }
                    console.error('Error loading staff details:', error);
                    modernUI.showToast({
                        title: 'Error',
                        message: 'Failed to load staff details. Please try again.',
                        type: 'error'
                    });
                });
        }
                                                <div class="row">
                                                    <div class="col-sm-4"><strong>Modified:</strong></div>
                                                    <div class="col-sm-8">${staff.Modified}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `,
                            buttons: [
                                {
                                    text: 'Edit Staff',
                                    class: 'btn-primary',
                                    icon: 'bi bi-pencil',
                                    onclick: `window.location.href='/Staff/StaffAddEdit/${id}'`
                                },
                                {
                                    text: 'Close',
                                    class: 'btn-secondary',
                                    onclick: 'modernUI.closeModal()'
                                }
                            ]
                        });
                    } else {
                        modernUI.showToast({
                            title: 'Error',
                            message: data.message || 'Failed to load staff details',
                            type: 'error'
                        });
                    }
                })
                .catch(error => {
                    modernUI.showToast({
                        title: 'Error',
                        message: 'Failed to load staff details',
                        type: 'error'
                    });
                });
        }

        function deleteStaff(id, name) {
            modernUI.showConfirmation({
                title: 'Delete Staff Member',
                message: `Are you sure you want to delete the staff member "<strong>${name}</strong>"?<br><small class="text-muted">This action cannot be undone.</small>`,
                confirmText: 'Delete Staff Member',
                confirmClass: 'btn-danger',
                onConfirm: () => {
                    fetch('/Staff/Delete', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: `id=${id}`
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            modernUI.showToast({
                                title: 'Success',
                                message: data.message || 'Staff member deleted successfully',
                                type: 'success'
                            });
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            modernUI.showToast({
                                title: 'Error',
                                message: data.message || 'Failed to delete staff member',
                                type: 'error'
                            });
                        }
                    })
                    .catch(error => {
                        modernUI.showToast({
                            title: 'Error',
                            message: 'Failed to delete staff member',
                            type: 'error'
                        });
                    });
                }
            });
        }

        // Initialize live search
        document.addEventListener('DOMContentLoaded', function() {
            modernUI.setupLiveSearch('input[name="searchTerm"]', '#staffTable');
        });
    </script>
}