@model MOM.Models.StaffModel

@{
    ViewData["Title"] = Model.StaffID > 0 ? "Edit Staff Member" : "Add Staff Member";
    bool isEdit = Model.StaffID > 0;
    var departments = ViewBag.Departments as List<dynamic> ?? new List<dynamic>();
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-person me-2"></i>@(isEdit ? "Edit Staff Member" : "Add Staff Member")</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="breadcrumb-item">Master</li>
                    <li class="breadcrumb-item">
                        <a asp-action="StaffList">Staff</a>
                    </li>
                    <li class="breadcrumb-item active">@(isEdit ? "Edit" : "Add")</li>
                </ol>
            </nav>
        </div>
        <a asp-action="StaffList" class="btn btn-light">
            <i class="bi bi-arrow-left me-1"></i>
            Back to List
        </a>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="section">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-hover">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <div class="avatar bg-primary me-3">
                            <i class="bi bi-person"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 text-white">
                                @(isEdit ? "Edit Staff Member" : "Add New Staff Member")
                            </h5>
                            <p class="mb-0 text-white-50 small">
                                @(isEdit ? "Update staff member information" : "Create a new staff member")
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <form asp-action="StaffAddEdit" method="post" id="staffForm" novalidate>
                        @Html.AntiForgeryToken()
                        
                        <!-- Hidden ID for Edit -->
                        <input type="hidden" asp-for="StaffID" />
                        <input type="hidden" asp-for="Created" />

                        <div class="row">
                            <div class="col-md-8">
                                <div class="row">
                                    <!-- Staff Name -->
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="StaffName" class="form-label">
                                            <i class="bi bi-person me-1"></i>
                                            Staff Name 
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="StaffName"
                                               class="form-control"
                                               maxlength="50"
                                               placeholder="Enter staff name"
                                               autocomplete="off" />
                                        <span asp-validation-for="StaffName" class="text-danger small"></span>
                                    </div>

                                    <!-- Department -->
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="DepartmentID" class="form-label">
                                            <i class="bi bi-building me-1"></i>
                                            Department 
                                            <span class="text-danger">*</span>
                                        </label>
                                        <select asp-for="DepartmentID" class="form-select">
                                            <option value="">Select Department</option>
                                            @foreach (var dept in departments)
                                            {
                                                <option value="@dept.Value">@dept.Text</option>
                                            }
                                        </select>
                                        <span asp-validation-for="DepartmentID" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <!-- Email Address -->
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="EmailAddress" class="form-label">
                                            <i class="bi bi-envelope me-1"></i>
                                            Email Address 
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="EmailAddress"
                                               class="form-control"
                                               type="email"
                                               maxlength="50"
                                               placeholder="Enter email address"
                                               autocomplete="off" />
                                        <span asp-validation-for="EmailAddress" class="text-danger small"></span>
                                    </div>

                                    <!-- Mobile Number -->
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="MobileNo" class="form-label">
                                            <i class="bi bi-phone me-1"></i>
                                            Mobile Number 
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="MobileNo"
                                               class="form-control"
                                               type="tel"
                                               maxlength="20"
                                               placeholder="Enter mobile number"
                                               autocomplete="off" />
                                        <span asp-validation-for="MobileNo" class="text-danger small"></span>
                                    </div>
                                </div>

                                <!-- Remarks -->
                                <div class="mb-3">
                                    <label asp-for="Remarks" class="form-label">
                                        <i class="bi bi-chat-text me-1"></i>
                                        Remarks
                                    </label>
                                    <textarea asp-for="Remarks"
                                              class="form-control"
                                              rows="3"
                                              maxlength="250"
                                              placeholder="Enter any additional remarks (optional)"
                                              autocomplete="off"></textarea>
                                    <span asp-validation-for="Remarks" class="text-danger small"></span>
                                    <div class="form-text">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Optional field for additional information about the staff member
                                    </div>
                                </div>
                            </div>

                            @if (isEdit)
                            {
                                <div class="col-md-4">
                                    <!-- Staff Statistics -->
                                    <div class="card border-0 bg-light">
                                        <div class="card-body">
                                            <h6 class="card-title text-primary">
                                                <i class="bi bi-graph-up me-1"></i>
                                                Statistics
                                            </h6>
                                            <div class="text-center">
                                                <h4 class="text-success mb-0">@Model.MeetingCount</h4>
                                                <small class="text-muted">Meeting Participations</small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Current Department -->
                                    <div class="card border-0 bg-light mt-3">
                                        <div class="card-body">
                                            <h6 class="card-title text-info">
                                                <i class="bi bi-building me-1"></i>
                                                Current Department
                                            </h6>
                                            <div class="text-center">
                                                <span class="badge bg-info fs-6">@Model.DepartmentName</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Audit Information -->
                                    <div class="card border-0 bg-light mt-3">
                                        <div class="card-body">
                                            <h6 class="card-title text-secondary">
                                                <i class="bi bi-clock-history me-1"></i>
                                                Audit Trail
                                            </h6>
                                            <div class="small">
                                                <div class="mb-2">
                                                    <strong>Created:</strong><br>
                                                    <span class="text-muted">@Model.Created.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                </div>
                                                <div>
                                                    <strong>Modified:</strong><br>
                                                    <span class="text-muted">@Model.Modified.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Form Actions -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <button type="button" class="btn btn-outline-secondary" onclick="resetForm()">
                                            <i class="bi bi-arrow-clockwise me-1"></i>
                                            Reset
                                        </button>
                                    </div>
                                    <div>
                                        <button type="submit" class="btn btn-primary" id="submitBtn">
                                            <i class="bi bi-@(isEdit ? "check" : "plus")-lg me-1"></i>
                                            @(isEdit ? "Update Staff Member" : "Save Staff Member")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            @if (isEdit && Model.MeetingCount > 0)
            {
                <!-- Related Information -->
                <div class="card mt-4 shadow-hover">
                    <div class="card-header">
                        <h6 class="mb-0 text-white">
                            <i class="bi bi-link-45deg me-1"></i>
                            Related Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="card border-0 bg-success bg-opacity-10">
                            <div class="card-body d-flex align-items-center">
                                <div class="avatar bg-success me-3">
                                    <i class="bi bi-calendar-event-fill"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0">@Model.MeetingCount Meeting Participations</h6>
                                    <small class="text-muted">This staff member has participated in meetings</small>
                                </div>
                            </div>
                        </div>
                        <div class="alert alert-warning mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <strong>Note:</strong> This staff member cannot be deleted as they have meeting participation records.
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Guidelines Sidebar -->
        <div class="col-lg-4">
            <div class="card shadow-hover">
                <div class="card-header">
                    <h6 class="mb-0 text-white">
                        <i class="bi bi-info-circle me-1"></i>Staff Guidelines
                    </h6>
                </div>
                <div class="card-body">
                    <div class="guidelines-panel tips">
                        <div class="guidelines-header">
                            <i class="bi bi-lightbulb"></i>
                            Best Practices
                        </div>
                        <div class="guidelines-content">
                            <ul>
                                <li>Use full names for staff members</li>
                                <li>Ensure email addresses are unique and valid</li>
                                <li>Include country code for mobile numbers</li>
                                <li>Assign to appropriate department</li>
                                <li>Add meaningful remarks for context</li>
                            </ul>
                        </div>
                    </div>

                    <div class="guidelines-panel warning">
                        <div class="guidelines-header">
                            <i class="bi bi-exclamation-triangle"></i>
                            Important Notes
                        </div>
                        <div class="guidelines-content">
                            <ul>
                                <li><strong>Email addresses must be unique</strong></li>
                                <li>Cannot delete staff with meeting records</li>
                                <li>Department assignment affects meeting access</li>
                                <li>Mobile format: +1234567890 or 1234567890</li>
                            </ul>
                        </div>
                    </div>

                    @if (isEdit)
                    {
                        <div class="info-card">
                            <h6 class="info-card-title">
                                <i class="bi bi-clock-history me-1"></i>Staff History
                            </h6>
                            <div class="info-card-content">
                                <div class="info-item">
                                    <span class="info-label">Created:</span>
                                    <span class="info-value">@Model.Created.ToString("MMM dd, yyyy hh:mm tt")</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">Last Modified:</span>
                                    <span class="info-value">@Model.Modified.ToString("MMM dd, yyyy hh:mm tt")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow-hover">
                <div class="card-header">
                    <h6 class="mb-0 text-white">
                        <i class="bi bi-lightning me-1"></i>Quick Actions
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="StaffList" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-list me-1"></i>View All Staff
                        </a>
                        <a asp-controller="Department" asp-action="DepartmentList" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-building me-1"></i>Manage Departments
                        </a>
                        @if (isEdit)
                        {
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="viewStaffMeetings()">
                                <i class="bi bi-calendar-event me-1"></i>View Staff Meetings
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize modern form validation
            modernUI.initializeFormValidation('#staffForm', {
                'StaffName': {
                    required: true,
                    minLength: 2,
                    maxLength: 50,
                    pattern: /^[a-zA-Z\s.'-]+$/,
                    messages: {
                        required: 'Staff name is required',
                        minLength: 'Name must be at least 2 characters',
                        maxLength: 'Name cannot exceed 50 characters',
                        pattern: 'Only letters, spaces, dots, apostrophes, and hyphens are allowed'
                    }
                },
                'EmailAddress': {
                    required: true,
                    email: true,
                    maxLength: 50,
                    messages: {
                        required: 'Email address is required',
                        email: 'Please enter a valid email address',
                        maxLength: 'Email cannot exceed 50 characters'
                    }
                },
                'MobileNo': {
                    required: true,
                    minLength: 10,
                    maxLength: 20,
                    pattern: /^[\+]?[0-9\s\-\(\)]+$/,
                    messages: {
                        required: 'Mobile number is required',
                        minLength: 'Mobile number must be at least 10 digits',
                        maxLength: 'Mobile number cannot exceed 20 characters',
                        pattern: 'Please enter a valid mobile number'
                    }
                },
                'DepartmentID': {
                    required: true,
                    messages: {
                        required: 'Please select a department'
                    }
                }
            });

            // Form submission with loading state
            const form = document.getElementById('staffForm');
            const submitBtn = document.getElementById('submitBtn');
            
            form.addEventListener('submit', function(e) {
                if (!modernUI.validateForm('#staffForm')) {
                    e.preventDefault();
                    return false;
                }
                
                // Show loading state
                modernUI.setButtonLoading(submitBtn, 'Saving...');
            });

            // Character counter for remarks
            const remarksField = document.querySelector('textarea[name="Remarks"]');
            if (remarksField) {
                modernUI.initializeCharacterCounter(remarksField, 100);
            }
        });

        function resetForm() {
            modernUI.showConfirmation({
                title: 'Reset Form',
                message: 'Are you sure you want to reset the form? All changes will be lost.',
                confirmText: 'Reset',
                confirmClass: 'btn-warning',
                onConfirm: () => {
                    document.getElementById('staffForm').reset();
                    modernUI.clearFormValidation('#staffForm');
                    modernUI.showToast('Form has been reset', 'info');
                }
            });
        }

        // Quick action functions
        function viewStaffMeetings() {
            @if (isEdit)
            {
                <text>
                window.location.href = '/MeetingMembers/MeetingMemberList?staffFilter=@Model.StaffID';
                </text>
            }
            else
            {
                <text>
                modernUI.showToast('Please save the staff member first', 'info');
                </text>
            }
        }

        // Guidelines are now permanently visible with CSS !important rules
        // No JavaScript hiding of any alerts - guidelines stay visible forever
    </script>
}