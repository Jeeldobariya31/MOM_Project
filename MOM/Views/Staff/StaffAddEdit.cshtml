@model MOM.Models.StaffModel

@{
    ViewData["Title"] = Model.StaffID > 0 ? "Edit Staff Member" : "Add Staff Member";
    bool isEdit = Model.StaffID > 0;
    var departments = ViewBag.Departments as List<dynamic> ?? new List<dynamic>();
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-person me-2"></i>@(isEdit ? "Edit Staff Member" : "Add Staff Member")</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="breadcrumb-item">Master</li>
                    <li class="breadcrumb-item">
                        <a asp-action="StaffList">Staff</a>
                    </li>
                    <li class="breadcrumb-item active">@(isEdit ? "Edit" : "Add")</li>
                </ol>
            </nav>
        </div>
        <a asp-action="StaffList" class="btn btn-light">
            <i class="bi bi-arrow-left me-1"></i>
            Back to List
        </a>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="section">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-hover">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <div class="avatar bg-primary me-3">
                            <i class="bi bi-person"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 text-white">
                                @(isEdit ? "Edit Staff Member" : "Add New Staff Member")
                            </h5>
                            <p class="mb-0 text-white-50 small">
                                @(isEdit ? "Update staff member information" : "Create a new staff member")
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <form asp-action="StaffAddEdit" method="post" id="staffForm" novalidate>
                        @Html.AntiForgeryToken()
                        
                        <!-- Hidden ID for Edit -->
                        <input type="hidden" asp-for="StaffID" />
                        <input type="hidden" asp-for="Created" />

                        <div class="row">
                            <div class="col-md-8">
                                <div class="row">
                                    <!-- Staff Name -->
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="StaffName" class="form-label">
                                            <i class="bi bi-person me-1"></i>
                                            Staff Name 
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="StaffName"
                                               class="form-control"
                                               maxlength="50"
                                               placeholder="Enter staff name"
                                               autocomplete="off" />
                                        <span asp-validation-for="StaffName" class="text-danger small"></span>
                                    </div>

                                    <!-- Department -->
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="DepartmentID" class="form-label">
                                            <i class="bi bi-building me-1"></i>
                                            Department 
                                            <span class="text-danger">*</span>
                                        </label>
                                        <select asp-for="DepartmentID" class="form-select">
                                            <option value="">Select Department</option>
                                            @foreach (var dept in departments)
                                            {
                                                <option value="@dept.Value">@dept.Text</option>
                                            }
                                        </select>
                                        <span asp-validation-for="DepartmentID" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <!-- Email Address -->
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="EmailAddress" class="form-label">
                                            <i class="bi bi-envelope me-1"></i>
                                            Email Address 
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="EmailAddress"
                                               class="form-control"
                                               type="email"
                                               maxlength="50"
                                               placeholder="Enter email address"
                                               autocomplete="off" />
                                        <span asp-validation-for="EmailAddress" class="text-danger small"></span>
                                    </div>

                                    <!-- Mobile Number -->
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="MobileNo" class="form-label">
                                            <i class="bi bi-phone me-1"></i>
                                            Mobile Number 
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="MobileNo"
                                               class="form-control"
                                               type="tel"
                                               maxlength="20"
                                               placeholder="Enter mobile number"
                                               autocomplete="off" />
                                        <span asp-validation-for="MobileNo" class="text-danger small"></span>
                                    </div>
                                </div>

                                <!-- Remarks -->
                                <div class="mb-3">
                                    <label asp-for="Remarks" class="form-label">
                                        <i class="bi bi-chat-text me-1"></i>
                                        Remarks
                                    </label>
                                    <textarea asp-for="Remarks"
                                              class="form-control"
                                              rows="3"
                                              maxlength="250"
                                              placeholder="Enter any additional remarks (optional)"
                                              autocomplete="off"></textarea>
                                    <span asp-validation-for="Remarks" class="text-danger small"></span>
                                    <div class="form-text">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Optional field for additional information about the staff member
                                    </div>
                                </div>
                            </div>

                            @if (isEdit)
                            {
                                <div class="col-md-4">
                                    <!-- Staff Statistics -->
                                    <div class="card border-0 bg-light">
                                        <div class="card-body">
                                            <h6 class="card-title text-primary">
                                                <i class="bi bi-graph-up me-1"></i>
                                                Statistics
                                            </h6>
                                            <div class="text-center">
                                                <h4 class="text-success mb-0">@Model.MeetingCount</h4>
                                                <small class="text-muted">Meeting Participations</small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Current Department -->
                                    <div class="card border-0 bg-light mt-3">
                                        <div class="card-body">
                                            <h6 class="card-title text-info">
                                                <i class="bi bi-building me-1"></i>
                                                Current Department
                                            </h6>
                                            <div class="text-center">
                                                <span class="badge bg-info fs-6">@Model.DepartmentName</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Audit Information -->
                                    <div class="card border-0 bg-light mt-3">
                                        <div class="card-body">
                                            <h6 class="card-title text-secondary">
                                                <i class="bi bi-clock-history me-1"></i>
                                                Audit Trail
                                            </h6>
                                            <div class="small">
                                                <div class="mb-2">
                                                    <strong>Created:</strong><br>
                                                    <span class="text-muted">@Model.Created.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                </div>
                                                <div>
                                                    <strong>Modified:</strong><br>
                                                    <span class="text-muted">@Model.Modified.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Form Actions -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <button type="button" class="btn btn-outline-secondary" onclick="resetForm()">
                                            <i class="bi bi-arrow-clockwise me-1"></i>
                                            Reset
                                        </button>
                                    </div>
                                    <div>
                                        <button type="submit" class="btn btn-primary" id="submitBtn">
                                            <i class="bi bi-@(isEdit ? "check" : "plus")-lg me-1"></i>
                                            @(isEdit ? "Update Staff Member" : "Save Staff Member")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            @if (isEdit && Model.MeetingCount > 0)
            {
                <!-- Related Information -->
                <div class="card mt-4 shadow-hover">
                    <div class="card-header">
                        <h6 class="mb-0 text-white">
                            <i class="bi bi-link-45deg me-1"></i>
                            Related Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="card border-0 bg-success bg-opacity-10">
                            <div class="card-body d-flex align-items-center">
                                <div class="avatar bg-success me-3">
                                    <i class="bi bi-calendar-event-fill"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0">@Model.MeetingCount Meeting Participations</h6>
                                    <small class="text-muted">This staff member has participated in meetings</small>
                                </div>
                            </div>
                        </div>
                        <div class="alert alert-warning mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <strong>Note:</strong> This staff member cannot be deleted as they have meeting participation records.
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Form validation
            const form = document.getElementById('staffForm');
            const submitBtn = document.getElementById('submitBtn');
            const staffNameInput = document.querySelector('input[name="StaffName"]');
            const emailInput = document.querySelector('input[name="EmailAddress"]');
            const mobileInput = document.querySelector('input[name="MobileNo"]');
            const departmentSelect = document.querySelector('select[name="DepartmentID"]');

            // Real-time validation
            staffNameInput.addEventListener('input', validateStaffName);
            emailInput.addEventListener('input', validateEmail);
            mobileInput.addEventListener('input', validateMobile);
            departmentSelect.addEventListener('change', validateDepartment);

            // Form submission
            form.addEventListener('submit', function(e) {
                if (!modernUI.validateForm('#staffForm')) {
                    e.preventDefault();
                    return false;
                }
                
                // Show loading state
                modernUI.showLoading(submitBtn, 'Saving...');
            });

            function validateStaffName() {
                const value = staffNameInput.value.trim();
                
                if (value.length < 2) {
                    modernUI.showFieldError(staffNameInput, 'Staff name must be at least 2 characters');
                    return false;
                } else if (value.length > 50) {
                    modernUI.showFieldError(staffNameInput, 'Staff name cannot exceed 50 characters');
                    return false;
                } else if (!/^[a-zA-Z\s.'-]+$/.test(value)) {
                    modernUI.showFieldError(staffNameInput, 'Staff name contains invalid characters');
                    return false;
                } else {
                    modernUI.clearFieldError(staffNameInput);
                    return true;
                }
            }

            function validateEmail() {
                const value = emailInput.value.trim();
                const emailRegex = /^[^\\s@@]+@@[^\\s@@]+\\.[^\\s@@]+$/;
                
                if (value.length === 0) {
                    modernUI.showFieldError(emailInput, 'Email address is required');
                    return false;
                } else if (!emailRegex.test(value)) {
                    modernUI.showFieldError(emailInput, 'Please enter a valid email address');
                    return false;
                } else if (value.length > 50) {
                    modernUI.showFieldError(emailInput, 'Email address cannot exceed 50 characters');
                    return false;
                } else {
                    modernUI.clearFieldError(emailInput);
                    return true;
                }
            }

            function validateMobile() {
                const value = mobileInput.value.trim();
                
                if (value.length < 10) {
                    modernUI.showFieldError(mobileInput, 'Mobile number must be at least 10 digits');
                    return false;
                } else if (value.length > 20) {
                    modernUI.showFieldError(mobileInput, 'Mobile number cannot exceed 20 characters');
                    return false;
                } else if (!/^[\+]?[0-9\s\-\(\)]+$/.test(value)) {
                    modernUI.showFieldError(mobileInput, 'Please enter a valid mobile number');
                    return false;
                } else {
                    modernUI.clearFieldError(mobileInput);
                    return true;
                }
            }

            function validateDepartment() {
                const value = departmentSelect.value;
                
                if (!value || value === "") {
                    modernUI.showFieldError(departmentSelect, 'Please select a department');
                    return false;
                } else {
                    modernUI.clearFieldError(departmentSelect);
                    return true;
                }
            }
        });

        function resetForm() {
            modernUI.showConfirmation({
                title: 'Reset Form',
                message: 'Are you sure you want to reset the form? All changes will be lost.',
                confirmText: 'Reset Form',
                confirmClass: 'btn-warning',
                onConfirm: () => {
                    document.getElementById('staffForm').reset();
                    // Remove validation classes
                    document.querySelectorAll('.is-valid, .is-invalid').forEach(el => {
                        el.classList.remove('is-valid', 'is-invalid');
                    });
                    modernUI.showToast({
                        title: 'Form Reset',
                        message: 'Form has been reset successfully',
                        type: 'info'
                    });
                }
            });
        }
    </script>
}