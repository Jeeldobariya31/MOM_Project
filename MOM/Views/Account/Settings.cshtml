@model MOM.Models.UserModel
@{
    ViewData["Title"] = "Account Settings";
    var userName = Context.Session.GetString("FullName") ?? "User";
    var userRole = Context.Session.GetString("Username") ?? "user";
    var userEmail = Context.Session.GetString("Email") ?? Model?.Email ?? "user@company.com";
}

<div class="pagetitle">
    <h1>Account Settings</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Account" asp-action="Profile">Profile</a>
            </li>
            <li class="breadcrumb-item active">Settings</li>
        </ol>
    </nav>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @ViewBag.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="section">
    <div class="row">
        <div class="col-lg-8">
            <!-- Profile Settings Card -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-person-gear me-2"></i>Profile Settings
                    </h5>

                    <form asp-action="UpdateProfile" method="post" class="row g-3">
                        <div class="col-12">
                            <label for="fullName" class="form-label">Full Name</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input name="FullName" type="text" class="form-control" id="fullName" 
                                       value="@userName" required>
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="email" class="form-label">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input name="Email" type="email" class="form-control" id="email" 
                                       value="@userEmail" required>
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="username" class="form-label">Username</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                                <input type="text" class="form-control" id="username" 
                                       value="@userRole" readonly>
                            </div>
                            <div class="form-text">Username cannot be changed for security reasons.</div>
                        </div>

                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i>Update Profile
                            </button>
                            <a asp-action="Profile" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to Profile
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Account Information Card -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-info-circle me-2"></i>Account Information
                    </h5>

                    <div class="d-flex align-items-center mb-3">
                        <img src="~/assets/img/profile-img.jpg" alt="Profile" class="rounded-circle me-3" width="60">
                        <div>
                            <h6 class="mb-0">@userName</h6>
                            <small class="text-muted">@userRole</small>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 text-muted">Status:</div>
                        <div class="col-7">
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle me-1"></i>Active
                            </span>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 text-muted">Member Since:</div>
                        <div class="col-7">@(Model?.Created.ToString("MMM yyyy") ?? DateTime.Now.ToString("MMM yyyy"))</div>
                    </div>

                    @if (Model?.LastLogin != null)
                    {
                        <div class="row mb-2">
                            <div class="col-5 text-muted">Last Login:</div>
                            <div class="col-7">@Model.LastLogin?.ToString("MMM dd, HH:mm")</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Security Card -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-shield-lock me-2"></i>Security
                    </h5>

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-outline-warning" disabled>
                            <i class="bi bi-key me-1"></i>Change Password
                        </button>
                        <button type="button" class="btn btn-outline-info" disabled>
                            <i class="bi bi-shield-check me-1"></i>Two-Factor Auth
                        </button>
                    </div>

                    <div class="mt-3">
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Security features are coming soon.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
