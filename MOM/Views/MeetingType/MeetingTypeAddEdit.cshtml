@model MOM.Models.MeetingTypeModel

@{
    ViewData["Title"] = Model.MeetingTypeID > 0 ? "Edit Meeting Type" : "Add Meeting Type";
    bool isEdit = Model.MeetingTypeID > 0;
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-tags me-2"></i>@(isEdit ? "Edit Meeting Type" : "Add Meeting Type")</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="breadcrumb-item">Master</li>
                    <li class="breadcrumb-item">
                        <a asp-action="MeetingTypeList">Meeting Types</a>
                    </li>
                    <li class="breadcrumb-item active">@(isEdit ? "Edit" : "Add")</li>
                </ol>
            </nav>
        </div>
        <a asp-action="MeetingTypeList" class="btn btn-light">
            <i class="bi bi-arrow-left me-1"></i>
            Back to List
        </a>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="section">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-hover">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <div class="avatar bg-primary me-3">
                            <i class="bi bi-tags"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 text-white">
                                @(isEdit ? "Edit Meeting Type" : "Add New Meeting Type")
                            </h5>
                            <p class="mb-0 text-white-50 small">
                                @(isEdit ? "Update meeting type information" : "Create a new meeting type")
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <form asp-action="MeetingTypeAddEdit" method="post" id="meetingTypeForm" novalidate>
                        @Html.AntiForgeryToken()
                        
                        <!-- Hidden ID for Edit -->
                        <input type="hidden" asp-for="MeetingTypeID" />
                        <input type="hidden" asp-for="Created" />

                        <div class="row">
                            <div class="col-md-8">
                                <!-- Meeting Type Name -->
                                <div class="mb-4">
                                    <label asp-for="MeetingTypeName" class="form-label">
                                        <i class="bi bi-tags me-1"></i>
                                        Meeting Type Name 
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="MeetingTypeName"
                                           class="form-control form-control-modern"
                                           maxlength="100"
                                           placeholder="Enter meeting type name"
                                           autocomplete="off" />
                                    <span asp-validation-for="MeetingTypeName" class="text-danger small"></span>
                                    <div class="form-text">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Enter a unique meeting type name (2-100 characters)
                                    </div>
                                </div>

                                <!-- Remarks -->
                                <div class="mb-4">
                                    <label asp-for="Remarks" class="form-label">
                                        <i class="bi bi-chat-text me-1"></i>
                                        Remarks 
                                        <span class="text-danger">*</span>
                                    </label>
                                    <textarea asp-for="Remarks"
                                              class="form-control form-control-modern"
                                              rows="3"
                                              maxlength="100"
                                              placeholder="Enter remarks or description for this meeting type"
                                              autocomplete="off"></textarea>
                                    <span asp-validation-for="Remarks" class="text-danger small"></span>
                                    <div class="form-text">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Provide a brief description (5-100 characters)
                                    </div>
                                </div>
                            </div>

                            @if (isEdit)
                            {
                                <div class="col-md-4">
                                    <!-- Meeting Type Statistics -->
                                    <div class="stats-card">
                                        <div class="stats-card-body">
                                            <div class="stats-icon">
                                                <i class="bi bi-graph-up"></i>
                                            </div>
                                            <div class="stats-content">
                                                <h3 class="stats-number">@Model.MeetingCount</h3>
                                                <p class="stats-label">Total Meetings</p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Audit Information -->
                                    <div class="info-card mt-3">
                                        <h6 class="info-card-title">
                                            <i class="bi bi-clock-history me-1"></i>
                                            Audit Information
                                        </h6>
                                        <div class="info-card-content">
                                            <div class="info-item">
                                                <span class="info-label">Created:</span>
                                                <span class="info-value">@Model.Created.ToString("dd MMM yyyy, hh:mm tt")</span>
                                            </div>
                                            <div class="info-item">
                                                <span class="info-label">Modified:</span>
                                                <span class="info-value">@Model.Modified.ToString("dd MMM yyyy, hh:mm tt")</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Form Actions -->
                        <div class="form-actions">
                            <div class="d-flex justify-content-between align-items-center">
                                <a asp-action="MeetingTypeList" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-1"></i>
                                    Back to List
                                </a>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-outline-secondary" onclick="resetForm()">
                                        <i class="bi bi-arrow-clockwise me-1"></i>
                                        Reset
                                    </button>
                                    <button type="submit" class="btn btn-primary" id="submitBtn">
                                        <i class="bi bi-@(isEdit ? "check" : "plus")-lg me-1"></i>
                                        @(isEdit ? "Update Meeting Type" : "Save Meeting Type")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            @if (isEdit && Model.MeetingCount > 0)
            {
                <!-- Related Information -->
                <div class="card shadow-hover mt-4">
                    <div class="card-header">
                        <h6 class="mb-0 text-white">
                            <i class="bi bi-link-45deg me-1"></i>
                            Related Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-calendar-event-fill text-info fs-4 me-3"></i>
                                <div>
                                    <h6 class="mb-0">@Model.MeetingCount Meetings</h6>
                                    <small class="text-muted">Associated with this meeting type</small>
                                </div>
                            </div>
                        </div>
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <strong>Note:</strong> This meeting type cannot be deleted as it has associated meetings.
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize modern form validation
            modernUI.initializeFormValidation('#meetingTypeForm', {
                'MeetingTypeName': {
                    required: true,
                    minLength: 2,
                    maxLength: 100,
                    pattern: /^[a-zA-Z0-9\s&.-]+$/,
                    messages: {
                        required: 'Meeting type name is required',
                        minLength: 'Name must be at least 2 characters',
                        maxLength: 'Name cannot exceed 100 characters',
                        pattern: 'Only letters, numbers, spaces, &, ., and - are allowed'
                    }
                },
                'Remarks': {
                    required: true,
                    minLength: 5,
                    maxLength: 100,
                    messages: {
                        required: 'Remarks are required',
                        minLength: 'Remarks must be at least 5 characters',
                        maxLength: 'Remarks cannot exceed 100 characters'
                    }
                }
            });

            // Form submission with loading state
            const form = document.getElementById('meetingTypeForm');
            const submitBtn = document.getElementById('submitBtn');
            
            form.addEventListener('submit', function(e) {
                if (!modernUI.validateForm('#meetingTypeForm')) {
                    e.preventDefault();
                    return false;
                }
                
                // Show loading state
                modernUI.setButtonLoading(submitBtn, 'Saving...');
            });

            // Character counter for remarks
            const remarksField = document.querySelector('textarea[name="Remarks"]');
            if (remarksField) {
                modernUI.initializeCharacterCounter(remarksField, 100);
            }
        });

        function resetForm() {
            modernUI.showConfirmModal({
                title: 'Reset Form',
                message: 'Are you sure you want to reset the form? All changes will be lost.',
                confirmText: 'Reset',
                confirmClass: 'btn-warning',
                onConfirm: () => {
                    document.getElementById('meetingTypeForm').reset();
                    modernUI.clearFormValidation('#meetingTypeForm');
                    modernUI.showToast('Form has been reset', 'info');
                }
            });
        }

        // Auto-hide alerts
        modernUI.autoHideAlerts();
    </script>
}