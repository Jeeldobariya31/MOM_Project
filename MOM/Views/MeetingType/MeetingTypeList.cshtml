@model System.Data.DataTable

@{
    ViewData["Title"] = "Meeting Type List";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var sortBy = ViewBag.SortBy as string ?? "MeetingTypeName";
    var sortOrder = ViewBag.SortOrder as string ?? "asc";
    var totalRecords = ViewBag.TotalRecords as int? ?? 0;
    var filteredRecords = ViewBag.FilteredRecords as int? ?? 0;
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-tags me-2"></i>Meeting Type Management</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="breadcrumb-item">Master</li>
                    <li class="breadcrumb-item active">Meeting Types</li>
                </ol>
            </nav>
        </div>
        <a asp-action="MeetingTypeAddEdit" class="btn btn-light">
            <i class="bi bi-plus-lg me-1"></i>
            Add Meeting Type
        </a>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-hover">
                <div class="card-body">
                    <!-- Header with Stats -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h5 class="card-title mb-1">
                                <i class="bi bi-tags text-primary me-2"></i>
                                Meeting Type Management
                            </h5>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Showing @filteredRecords of @totalRecords meeting types
                            </p>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="modernUI.exportTable('#meetingTypeTable', 'meeting-types', 'csv')">
                                <i class="bi bi-file-earmark-excel me-1"></i>
                                Export
                            </button>
                            <a asp-action="MeetingTypeAddEdit" class="btn btn-primary">
                                <i class="bi bi-plus-lg me-1"></i>
                                Add Meeting Type
                            </a>
                        </div>
                    </div>

                    <!-- Search and Filter Section -->
                    <div class="filter-section">
                        <form method="get" class="row g-3">
                            <input type="hidden" name="sortBy" value="@sortBy" />
                            <input type="hidden" name="sortOrder" value="@sortOrder" />
                            
                            <div class="col-md-6">
                                <label class="form-label">Search</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                                    <input type="text" name="searchTerm" value="@searchTerm" 
                                           class="form-control" placeholder="Search meeting types..." />
                                    <button type="submit" class="btn btn-primary">Search</button>
                                    @if (!string.IsNullOrEmpty(searchTerm))
                                    {
                                        <a href="@Url.Action("MeetingTypeList")" class="btn btn-outline-secondary">
                                            <i class="bi bi-x-lg"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Data Table -->
                    <div class="table-responsive">
                        <table class="table table-modern" id="meetingTypeTable">
                            <thead>
                                <tr>
                                    <th>
                                        <a href="@Url.Action("MeetingTypeList", new { searchTerm, sortBy = "MeetingTypeName", sortOrder = (sortBy == "MeetingTypeName" && sortOrder == "asc") ? "desc" : "asc" })" 
                                           class="text-decoration-none">
                                            <i class="bi bi-tags me-1"></i>Meeting Type Name
                                            @if (sortBy == "MeetingTypeName")
                                            {
                                                <i class="bi bi-arrow-@(sortOrder == "asc" ? "up" : "down") ms-1"></i>
                                            }
                                        </a>
                                    </th>
                                    <th><i class="bi bi-chat-text me-1"></i>Remarks</th>
                                    <th>
                                        <a href="@Url.Action("MeetingTypeList", new { searchTerm, sortBy = "Created", sortOrder = (sortBy == "Created" && sortOrder == "asc") ? "desc" : "asc" })" 
                                           class="text-decoration-none">
                                            <i class="bi bi-calendar me-1"></i>Created Date
                                            @if (sortBy == "Created")
                                            {
                                                <i class="bi bi-arrow-@(sortOrder == "asc" ? "up" : "down") ms-1"></i>
                                            }
                                        </a>
                                    </th>
                                    <th class="text-center"><i class="bi bi-gear me-1"></i>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Rows.Count > 0)
                                {
                                    @foreach (System.Data.DataRow row in Model.Rows)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar bg-info me-3">
                                                        <i class="bi bi-tags"></i>
                                                    </div>
                                                    <div>
                                                        <div class="title">@row["MeetingTypeName"]</div>
                                                        <div class="subtitle">ID: @row["MeetingTypeID"]</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="remarks-cell">@row["Remarks"]</div>
                                            </td>
                                            <td>
                                                <div class="date-time-cell">
                                                    <div class="date">@Convert.ToDateTime(row["Created"]).ToString("dd MMM yyyy")</div>
                                                    <div class="time">@Convert.ToDateTime(row["Created"]).ToString("hh:mm tt")</div>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <div class="action-buttons">
                                                    <button type="button" 
                                                            class="btn btn-sm btn-outline-primary" 
                                                            onclick="viewMeetingType(@row["MeetingTypeID"])"
                                                            title="View Details">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <a asp-action="MeetingTypeAddEdit" 
                                                       asp-route-id="@row["MeetingTypeID"]"
                                                       class="btn btn-sm btn-outline-secondary"
                                                       title="Edit">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <button type="button" 
                                                            class="btn btn-sm btn-outline-danger" 
                                                            onclick="deleteMeetingType(@row["MeetingTypeID"], '@row["MeetingTypeName"]')"
                                                            title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4">
                                            <div class="empty-state">
                                                <i class="bi bi-tags"></i>
                                                <h6>No meeting types found</h6>
                                                @if (!string.IsNullOrEmpty(searchTerm))
                                                {
                                                    <p>No meeting types found matching "@searchTerm"</p>
                                                    <a href="@Url.Action("MeetingTypeList")" class="btn btn-outline-primary btn-sm">
                                                        Clear Search
                                                    </a>
                                                }
                                                else
                                                {
                                                    <p>No meeting types found</p>
                                                    <a asp-action="MeetingTypeAddEdit" class="btn btn-primary btn-sm">
                                                        Add First Meeting Type
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



@section Scripts {
    <script>
        // View meeting type details
        function viewMeetingType(id) {
            const button = document.querySelector(`button[onclick="viewMeetingType(${id})"]`);
            if (button) {
                modernUI.setButtonLoading(button, 'Loading...');
            }
            
            fetch(`/MeetingType/GetMeetingTypeDetails/${id}`)
                .then(response => response.json())
                .then(data => {
                    if (button) {
                        modernUI.resetButton(button);
                    }
                    
                    if (data.success) {
                        const meetingType = data.data;
                        modernUI.showModal({
                            title: `<i class="bi bi-tags me-2"></i>Meeting Type Details`,
                            size: 'lg',
                            content: `
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title text-primary mb-3">
                                                    <i class="bi bi-info-circle me-1"></i>Basic Information
                                                </h6>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Type ID:</strong></div>
                                                    <div class="col-sm-7">${modernUI.safeValue(meetingType.MeetingTypeID)}</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Type Name:</strong></div>
                                                    <div class="col-sm-7">${modernUI.safeValue(meetingType.MeetingTypeName)}</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Created:</strong></div>
                                                    <div class="col-sm-7">${modernUI.formatDate(meetingType.Created)}</div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-5"><strong>Modified:</strong></div>
                                                    <div class="col-sm-7">${modernUI.formatDate(meetingType.Modified)}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title text-success mb-3">
                                                    <i class="bi bi-bar-chart me-1"></i>Statistics & Details
                                                </h6>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Meetings:</strong></div>
                                                    <div class="col-sm-7"><span class="badge bg-success">${modernUI.safeValue(meetingType.MeetingCount, '0')}</span></div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-5"><strong>Remarks:</strong></div>
                                                    <div class="col-sm-7">${modernUI.safeValue(meetingType.Remarks, 'No remarks')}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `,
                            buttons: [
                                {
                                    text: 'Edit Type',
                                    class: 'btn-primary',
                                    icon: 'bi bi-pencil',
                                    onclick: `window.location.href='/MeetingType/MeetingTypeAddEdit/${id}'`
                                },
                                {
                                    text: 'Close',
                                    class: 'btn-secondary',
                                    onclick: 'modernUI.closeModal()'
                                }
                            ]
                        });
                    } else {
                        modernUI.showToast({
                            title: 'Error',
                            message: data.message || 'Failed to load meeting type details',
                            type: 'error'
                        });
                    }
                })
                .catch(error => {
                    if (button) {
                        modernUI.resetButton(button);
                    }
                    console.error('Error loading meeting type details:', error);
                    modernUI.showToast({
                        title: 'Error',
                        message: 'Failed to load meeting type details. Please try again.',
                        type: 'error'
                    });
                });
        }
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    document.querySelector('#customModal .custom-modal-body').innerHTML = 
                        '<div class="alert alert-danger">Failed to load meeting type details</div>';
                });
        }

        // Delete meeting type
        function deleteMeetingType(id, name) {
            modernUI.showConfirmation({
                title: 'Delete Meeting Type',
                message: `Are you sure you want to delete the meeting type "<strong>${name}</strong>"?<br><small class="text-muted">This action cannot be undone.</small>`,
                confirmText: 'Delete Meeting Type',
                confirmClass: 'btn-danger',
                onConfirm: () => {
                    fetch('/MeetingType/Delete', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: `id=${id}`
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            modernUI.showToast(data.message, 'success');
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            modernUI.showToast(data.message, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        modernUI.showToast('Failed to delete meeting type', 'error');
                    });
                }
            });
        }

        // Auto-hide alerts
        modernUI.autoHideAlerts();
    </script>
}