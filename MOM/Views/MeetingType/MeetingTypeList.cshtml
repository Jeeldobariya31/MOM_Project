@model System.Data.DataTable

@{
    ViewData["Title"] = "Meeting Type List";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var sortBy = ViewBag.SortBy as string ?? "MeetingTypeName";
    var sortOrder = ViewBag.SortOrder as string ?? "asc";
    var totalRecords = ViewBag.TotalRecords as int? ?? 0;
    var filteredRecords = ViewBag.FilteredRecords as int? ?? 0;
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-tags me-2"></i>Meeting Type Management</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="breadcrumb-item">Master</li>
                    <li class="breadcrumb-item active">Meeting Types</li>
                </ol>
            </nav>
        </div>
        <a asp-action="MeetingTypeAddEdit" class="btn btn-light">
            <i class="bi bi-plus-lg me-1"></i>
            Add Meeting Type
        </a>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-hover">
                <div class="card-body">
                    <!-- Header with Stats -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h5 class="card-title mb-1">
                                <i class="bi bi-tags text-primary me-2"></i>
                                Meeting Type Management
                            </h5>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Showing @filteredRecords of @totalRecords meeting types
                            </p>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="modernUI.exportTable('#meetingTypeTable', 'meeting-types', 'csv')">
                                <i class="bi bi-file-earmark-excel me-1"></i>
                                Export
                            </button>
                            <a asp-action="MeetingTypeAddEdit" class="btn btn-primary">
                                <i class="bi bi-plus-lg me-1"></i>
                                Add Meeting Type
                            </a>
                        </div>
                    </div>

                    <!-- Search and Filter Section -->
                    <div class="filter-section">
                        <form method="get" class="row g-3">
                            <input type="hidden" name="sortBy" value="@sortBy" />
                            <input type="hidden" name="sortOrder" value="@sortOrder" />
                            
                            <div class="col-md-6">
                                <label class="form-label">Search Meeting Types</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text" 
                                           name="searchTerm" 
                                           value="@searchTerm" 
                                           class="form-control" 
                                           placeholder="Search by type name or remarks..." />
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-search me-1"></i>Search
                                    </button>
                                </div>
                            </div>
                            
                            <div class="col-md-6 d-flex align-items-end">
                                @if (!string.IsNullOrEmpty(searchTerm))
                                {
                                    <a href="@Url.Action("MeetingTypeList")" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-lg me-1"></i>Clear Search
                                    </a>
                                }
                            </div>
                        </form>
                    </div>

                    <!-- Data Table -->
                    <div class="table-container">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle" id="meetingTypeTable">
                                <thead>
                                    <tr>
                                        <th>
                                            <a href="@Url.Action("MeetingTypeList", new { searchTerm, sortBy = "MeetingTypeName", sortOrder = (sortBy == "MeetingTypeName" && sortOrder == "asc") ? "desc" : "asc" })" 
                                               class="text-decoration-none text-dark d-flex align-items-center">
                                                Meeting Type Name
                                                @if (sortBy == "MeetingTypeName")
                                                {
                                                    <i class="bi bi-arrow-@(sortOrder == "asc" ? "up" : "down") ms-1"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>Remarks</th>
                                        <th>
                                            <a href="@Url.Action("MeetingTypeList", new { searchTerm, sortBy = "Created", sortOrder = (sortBy == "Created" && sortOrder == "asc") ? "desc" : "asc" })" 
                                               class="text-decoration-none text-dark d-flex align-items-center">
                                                Created Date
                                                @if (sortBy == "Created")
                                                {
                                                    <i class="bi bi-arrow-@(sortOrder == "asc" ? "up" : "down") ms-1"></i>
                                                }
                                            </a>
                                        </th>
                                        <th class="text-center" style="width: 200px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Rows.Count > 0)
                                    {
                                        @foreach (System.Data.DataRow row in Model.Rows)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar bg-primary me-3">
                                                            <i class="bi bi-tags"></i>
                                                        </div>
                                                        <div>
                                                            <h6 class="mb-0 fw-semibold">@row["MeetingTypeName"]</h6>
                                                            <small class="text-muted">ID: @row["MeetingTypeID"]</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(row["Remarks"]?.ToString()))
                                                    {
                                                        <div class="text-truncate" style="max-width: 200px;" title="@row["Remarks"]">
                                                            @row["Remarks"]
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No remarks</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div>
                                                        <span class="fw-medium">
                                                            @Convert.ToDateTime(row["Created"]).ToString("dd MMM yyyy")
                                                        </span>
                                                        <br>
                                                        <small class="text-muted">
                                                            @Convert.ToDateTime(row["Created"]).ToString("hh:mm tt")
                                                        </small>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group" role="group">
                                                        <button type="button" 
                                                                class="btn btn-outline-info btn-sm" 
                                                                onclick="viewMeetingType(@row["MeetingTypeID"])"
                                                                title="View Details">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <a asp-action="MeetingTypeAddEdit" 
                                                           asp-route-id="@row["MeetingTypeID"]"
                                                           class="btn btn-outline-primary btn-sm"
                                                           title="Edit">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                        <button type="button" 
                                                                class="btn btn-outline-danger btn-sm" 
                                                                onclick="deleteMeetingType(@row["MeetingTypeID"], '@row["MeetingTypeName"]')"
                                                                title="Delete">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4">
                                                <div class="empty-state">
                                                    <i class="bi bi-tags"></i>
                                                    @if (!string.IsNullOrEmpty(searchTerm))
                                                    {
                                                        <h3>No meeting types found</h3>
                                                        <p>No meeting types match your search criteria "@searchTerm"</p>
                                                        <a href="@Url.Action("MeetingTypeList")" class="btn btn-outline-primary">
                                                            <i class="bi bi-arrow-left me-1"></i>Clear Search
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <h3>No meeting types yet</h3>
                                                        <p>Get started by creating your first meeting type</p>
                                                        <a asp-action="MeetingTypeAddEdit" class="btn btn-primary">
                                                            <i class="bi bi-plus-lg me-1"></i>Add First Meeting Type
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        // View meeting type details
        function viewMeetingType(id) {
            const button = document.querySelector(`button[onclick="viewMeetingType(${id})"]`);
            if (button) {
                modernUI.setButtonLoading(button, 'Loading...');
            }
            
            fetch(`/MeetingType/GetMeetingTypeDetails?id=${id}`)
                .then(response => response.json())
                .then(data => {
                    if (button) {
                        modernUI.resetButton(button);
                    }
                    
                    if (data.success) {
                        const meetingType = data.data;
                        console.log('MeetingType data:', meetingType);
                        
                        // Helper function to safely get values
                        const safeValue = (value, defaultValue = 'N/A') => {
                            return (value !== null && value !== undefined && value !== '') ? value : defaultValue;
                        };
                        
                        modernUI.showModal({
                            title: `<i class="bi bi-tags me-2"></i>Meeting Type Details`,
                            size: 'lg',
                            content: `
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title text-primary mb-3">
                                                    <i class="bi bi-info-circle me-1"></i>Basic Information
                                                </h6>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Type ID:</strong></div>
                                                    <div class="col-sm-7">${safeValue(meetingType.meetingTypeID)}</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Type Name:</strong></div>
                                                    <div class="col-sm-7">${safeValue(meetingType.meetingTypeName)}</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Created:</strong></div>
                                                    <div class="col-sm-7">${safeValue(meetingType.created)}</div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-5"><strong>Modified:</strong></div>
                                                    <div class="col-sm-7">${safeValue(meetingType.modified)}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title text-success mb-3">
                                                    <i class="bi bi-bar-chart me-1"></i>Statistics & Details
                                                </h6>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Meetings:</strong></div>
                                                    <div class="col-sm-7"><span class="badge bg-success">${safeValue(meetingType.meetingCount, '0')}</span></div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-5"><strong>Remarks:</strong></div>
                                                    <div class="col-sm-7">${safeValue(meetingType.remarks, 'No remarks')}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `,
                            buttons: [
                                {
                                    text: 'Edit Type',
                                    class: 'btn-primary',
                                    icon: 'bi bi-pencil',
                                    onclick: `window.location.href='/MeetingType/MeetingTypeAddEdit/${id}'`
                                },
                                {
                                    text: 'Close',
                                    class: 'btn-secondary',
                                    onclick: 'modernUI.closeModal()'
                                }
                            ]
                        });
                    } else {
                        modernUI.showToast({
                            title: 'Error',
                            message: data.message || 'Failed to load meeting type details',
                            type: 'error'
                        });
                    }
                })
                .catch(error => {
                    if (button) {
                        modernUI.resetButton(button);
                    }
                    console.error('Error loading meeting type details:', error);
                    modernUI.showToast({
                        title: 'Error',
                        message: 'Failed to load meeting type details. Please try again.',
                        type: 'error'
                    });
                });
        }

        // Delete meeting type
        function deleteMeetingType(id, name) {
            modernUI.showConfirmation({
                title: 'Delete Meeting Type',
                message: `Are you sure you want to delete the meeting type "<strong>${name}</strong>"?<br><small class="text-muted">This action cannot be undone.</small>`,
                confirmText: 'Delete Meeting Type',
                confirmClass: 'btn-danger',
                onConfirm: () => {
                    fetch('/MeetingType/Delete', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: `id=${id}`
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            modernUI.showToast({
                                title: 'Success',
                                message: data.message || 'Meeting type deleted successfully',
                                type: 'success'
                            });
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            modernUI.showToast({
                                title: 'Error',
                                message: data.message || 'Failed to delete meeting type',
                                type: 'error'
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        modernUI.showToast({
                            title: 'Error',
                            message: 'Failed to delete meeting type',
                            type: 'error'
                        });
                    });
                }
            });
        }

        // Initialize live search
        document.addEventListener('DOMContentLoaded', function() {
            modernUI.setupLiveSearch('input[name="searchTerm"]', '#meetingTypeTable');
        });
    </script>
}