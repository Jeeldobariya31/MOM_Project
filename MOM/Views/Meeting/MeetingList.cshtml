@model System.Data.DataTable

@{
    ViewData["Title"] = "Meeting List";
    var searchTerm = ViewBag.Search as string ?? "";
    var totalRecords = ViewBag.TotalRecords as int? ?? 0;
    var filteredRecords = Model.Rows.Count;

    string GetValue(System.Data.DataRow row, string col)
    {
        return Model.Columns.Contains(col) ? row[col]?.ToString() ?? "" : "";
    }

    bool GetBool(System.Data.DataRow row, string col)
    {
        return Model.Columns.Contains(col) && row[col] != DBNull.Value && Convert.ToBoolean(row[col]);
    }

    DateTime GetDate(System.Data.DataRow row, string col)
    {
        return Model.Columns.Contains(col) && row[col] != DBNull.Value
            ? Convert.ToDateTime(row[col])
            : DateTime.MinValue;
    }

    int GetInt(System.Data.DataRow row, string col)
    {
        return Model.Columns.Contains(col) && row[col] != DBNull.Value
            ? Convert.ToInt32(row[col])
            : 0;
    }
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-calendar-event me-2"></i>Meeting Management</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Meetings</li>
                </ol>
            </nav>
        </div>
        <a asp-action="MeetingAddEdit" class="btn btn-light">
            <i class="bi bi-plus-lg me-1"></i>
            Schedule Meeting
        </a>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-hover">
                <div class="card-body">
                    <!-- Header with Stats -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h5 class="card-title mb-1">
                                <i class="bi bi-calendar-event text-primary me-2"></i>
                                Meeting Management
                            </h5>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Showing @filteredRecords of @totalRecords meetings
                            </p>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="modernUI.exportTable('#meetingTable', 'meetings', 'csv')">
                                <i class="bi bi-file-earmark-excel me-1"></i>
                                Export
                            </button>
                            <a asp-action="MeetingAddEdit" class="btn btn-primary">
                                <i class="bi bi-plus-lg me-1"></i>
                                Schedule Meeting
                            </a>
                        </div>
                    </div>

                    <!-- Search and Filter Section -->
                    <div class="filter-section">
                        <form method="get" class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Search</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                                    <input type="text" name="search" value="@ViewBag.Search" 
                                           class="form-control" placeholder="Search meetings..." />
                                </div>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Status</label>
                                <select name="statusFilter" class="form-select">
                                    <option value="">All Status</option>
                                    <option value="Upcoming" selected="@(ViewBag.StatusFilter == "Upcoming")">Upcoming</option>
                                    <option value="Today" selected="@(ViewBag.StatusFilter == "Today")">Today</option>
                                    <option value="Past" selected="@(ViewBag.StatusFilter == "Past")">Past</option>
                                    <option value="Cancelled" selected="@(ViewBag.StatusFilter == "Cancelled")">Cancelled</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Department</label>
                                <select name="departmentFilter" class="form-select">
                                    <option value="">All Departments</option>
                                    @foreach (System.Data.DataRow dept in ViewBag.Departments.Rows)
                                    {
                                        <option value="@dept["DepartmentID"]" 
                                                selected="@(ViewBag.DepartmentFilter.ToString() == dept["DepartmentID"].ToString())">
                                            @dept["DepartmentName"]
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Type</label>
                                <select name="typeFilter" class="form-select">
                                    <option value="">All Types</option>
                                    @foreach (System.Data.DataRow type in ViewBag.MeetingTypes.Rows)
                                    {
                                        <option value="@type["MeetingTypeID"]" 
                                                selected="@(ViewBag.TypeFilter.ToString() == type["MeetingTypeID"].ToString())">
                                            @type["MeetingTypeName"]
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Venue</label>
                                <select name="venueFilter" class="form-select">
                                    <option value="">All Venues</option>
                                    @foreach (System.Data.DataRow venue in ViewBag.MeetingVenues.Rows)
                                    {
                                        <option value="@venue["MeetingVenueID"]" 
                                                selected="@(ViewBag.VenueFilter.ToString() == venue["MeetingVenueID"].ToString())">
                                            @venue["MeetingVenueName"]
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">From Date</label>
                                <input type="date" name="dateFrom" value="@ViewBag.DateFrom" class="form-control" />
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">To Date</label>
                                <input type="date" name="dateTo" value="@ViewBag.DateTo" class="form-control" />
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Show</label>
                                <select name="pageSize" class="form-select" onchange="this.form.submit()">
                                    <option value="10" selected="@(ViewBag.PageSize == 10)">10</option>
                                    <option value="25" selected="@(ViewBag.PageSize == 25)">25</option>
                                    <option value="50" selected="@(ViewBag.PageSize == 50)">50</option>
                                    <option value="100" selected="@(ViewBag.PageSize == 100)">100</option>
                                </select>
                            </div>

                            <div class="col-md-6 d-flex align-items-end gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-search me-1"></i> Apply Filters
                                </button>
                                <a asp-action="MeetingList" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-clockwise me-1"></i> Reset
                                </a>
                            </div>
                        </form>
                    </div>

                    <!-- TABLE -->
                    <div class="table-responsive">
                        <table class="table table-modern" id="meetingTable">
                            <thead>
                                <tr>
                                    <th><i class="bi bi-calendar me-1"></i>Date & Time</th>
                                    <th><i class="bi bi-chat-text me-1"></i>Description</th>
                                    <th><i class="bi bi-tag me-1"></i>Type</th>
                                    <th><i class="bi bi-geo-alt me-1"></i>Venue</th>
                                    <th><i class="bi bi-building me-1"></i>Department</th>
                                    <th><i class="bi bi-people me-1"></i>Members</th>
                                    <th><i class="bi bi-check-circle me-1"></i>Status</th>
                                    <th class="text-center"><i class="bi bi-gear me-1"></i>Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.Rows.Count == 0)
                                {
                                    <tr>
                                        <td colspan="8">
                                            <div class="empty-state">
                                                <i class="bi bi-calendar-x"></i>
                                                <h6>No meetings found</h6>
                                                <p>No meetings match your current filter criteria.</p>
                                                <a asp-action="MeetingAddEdit" class="btn btn-primary btn-sm">
                                                    <i class="bi bi-plus-lg me-1"></i>Schedule First Meeting
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (System.Data.DataRow row in Model.Rows)
                                    {
                                        bool isCancelled = GetBool(row, "IsCancelled");
                                        DateTime date = GetDate(row, "MeetingDate");
                                        int memberCount = GetInt(row, "MemberCount");
                                        int presentCount = GetInt(row, "PresentCount");

                                        string status =
                                        isCancelled ? "Cancelled" :
                                        date.Date == DateTime.Today ? "Today" :
                                        date > DateTime.Now ? "Upcoming" :
                                        "Past";

                                        string id = GetValue(row, "MeetingID");
                                        string description = GetValue(row, "MeetingDescription");
                                        string type = GetValue(row, "MeetingTypeName");
                                        string venue = GetValue(row, "VenueName");
                                        string dept = GetValue(row, "DepartmentName");
                                        string docPath = GetValue(row, "DocumentPath");

                                        <tr class="@(isCancelled ? "table-muted" : "")">
                                            <td>
                                                <div class="date-time-cell">
                                                    <div class="date">@(date == DateTime.MinValue ? "" : date.ToString("MMM dd, yyyy"))</div>
                                                    <div class="time">@(date == DateTime.MinValue ? "" : date.ToString("hh:mm tt"))</div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="description-cell">
                                                    <div class="title">@description</div>
                                                    @if (!string.IsNullOrEmpty(docPath))
                                                    {
                                                        <div class="document">
                                                            <a href="@docPath" target="_blank" class="text-primary">
                                                                <i class="bi bi-file-earmark-text me-1"></i>Document
                                                            </a>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td><span class="badge badge-info">@type</span></td>
                                            <td>@venue</td>
                                            <td><span class="badge badge-secondary">@dept</span></td>
                                            <td>
                                                @if (memberCount > 0)
                                                {
                                                    <div class="member-stats">
                                                        <span class="badge badge-primary">@memberCount Total</span>
                                                        <span class="badge badge-success">@presentCount Present</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No members</span>
                                                }
                                            </td>
                                            <td>
                                                @if (status == "Cancelled")
                                                {
                                                    <span class="badge badge-danger">Cancelled</span>
                                                }
                                                else if (status == "Today")
                                                {
                                                    <span class="badge badge-warning">Today</span>
                                                }
                                                else if (status == "Upcoming")
                                                {
                                                    <span class="badge badge-success">Upcoming</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">Past</span>
                                                }
                                            </td>

                                            <td class="text-center">
                                                <div class="action-buttons">
                                                    <button type="button" class="btn btn-sm btn-outline-primary" 
                                                            onclick="viewMeeting(@id)" title="View Details">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <a asp-action="MeetingAddEdit" asp-route-id="@id"
                                                       class="btn btn-sm btn-outline-secondary" title="Edit Meeting">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>

                                                    @if (!isCancelled && date > DateTime.Now)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-warning" 
                                                                onclick="cancelMeeting(@id)" title="Cancel Meeting">
                                                            <i class="bi bi-x-circle"></i>
                                                        </button>
                                                    }

                                                    @if (!isCancelled || memberCount == 0)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-danger" 
                                                                onclick="deleteMeeting(@id)" title="Delete Meeting">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (ViewBag.TotalPages > 1)
                    {
                        <div class="pagination-wrapper">
                            <nav aria-label="Meeting pagination">
                                <ul class="pagination">
                                    @if (ViewBag.CurrentPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("MeetingList", new { 
                                                page = ViewBag.CurrentPage - 1, 
                                                search = ViewBag.Search,
                                                statusFilter = ViewBag.StatusFilter,
                                                departmentFilter = ViewBag.DepartmentFilter,
                                                typeFilter = ViewBag.TypeFilter,
                                                venueFilter = ViewBag.VenueFilter,
                                                dateFrom = ViewBag.DateFrom,
                                                dateTo = ViewBag.DateTo,
                                                pageSize = ViewBag.PageSize
                                            })">
                                                <i class="bi bi-chevron-left"></i>
                                            </a>
                                        </li>
                                    }

                                    @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                                    {
                                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("MeetingList", new { 
                                                page = i, 
                                                search = ViewBag.Search,
                                                statusFilter = ViewBag.StatusFilter,
                                                departmentFilter = ViewBag.DepartmentFilter,
                                                typeFilter = ViewBag.TypeFilter,
                                                venueFilter = ViewBag.VenueFilter,
                                                dateFrom = ViewBag.DateFrom,
                                                dateTo = ViewBag.DateTo,
                                                pageSize = ViewBag.PageSize
                                            })">@i</a>
                                        </li>
                                    }

                                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("MeetingList", new { 
                                                page = ViewBag.CurrentPage + 1, 
                                                search = ViewBag.Search,
                                                statusFilter = ViewBag.StatusFilter,
                                                departmentFilter = ViewBag.DepartmentFilter,
                                                typeFilter = ViewBag.TypeFilter,
                                                venueFilter = ViewBag.VenueFilter,
                                                dateFrom = ViewBag.DateFrom,
                                                dateTo = ViewBag.DateTo,
                                                pageSize = ViewBag.PageSize
                                            })">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</section>



@section Scripts {
    <script>
        // View meeting details
        function viewMeeting(meetingId) {
            const button = document.querySelector(`button[onclick="viewMeeting(${meetingId})"]`);
            if (button) {
                modernUI.setButtonLoading(button, 'Loading...');
            }
            
            fetch(`/Meeting/GetMeetingDetails?id=${meetingId}`)
                .then(response => response.json())
                .then(data => {
                    if (button) {
                        modernUI.resetButton(button);
                    }
                    
                    if (data.success) {
                        const meeting = data.data;
                        modernUI.showModal({
                            title: `<i class="bi bi-calendar-event me-2"></i>Meeting Details`,
                            size: 'lg',
                            content: `
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title text-primary mb-3">
                                                    <i class="bi bi-info-circle me-1"></i>Meeting Information
                                                </h6>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Description:</strong></div>
                                                    <div class="col-sm-7">${modernUI.safeValue(meeting.MeetingDescription)}</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Date & Time:</strong></div>
                                                    <div class="col-sm-7">${modernUI.formatDate(meeting.MeetingDate, 'dd MMM yyyy hh:mm')}</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Type:</strong></div>
                                                    <div class="col-sm-7"><span class="badge bg-info">${modernUI.safeValue(meeting.MeetingTypeName)}</span></div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-5"><strong>Venue:</strong></div>
                                                    <div class="col-sm-7">${modernUI.safeValue(meeting.MeetingVenueName)}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title text-success mb-3">
                                                    <i class="bi bi-bar-chart me-1"></i>Status & Statistics
                                                </h6>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Department:</strong></div>
                                                    <div class="col-sm-7"><span class="badge bg-secondary">${modernUI.safeValue(meeting.DepartmentName)}</span></div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Status:</strong></div>
                                                    <div class="col-sm-7"><span class="badge bg-${meeting.StatusClass || 'primary'}">${modernUI.safeValue(meeting.Status, 'Scheduled')}</span></div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-5"><strong>Members:</strong></div>
                                                    <div class="col-sm-7">
                                                        <span class="badge bg-success">${modernUI.safeValue(meeting.MemberCount, '0')} total</span>
                                                        <span class="badge bg-info ms-1">${modernUI.safeValue(meeting.PresentCount, '0')} present</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `,
                            buttons: [
                                {
                                    text: 'Edit Meeting',
                                    class: 'btn-primary',
                                    icon: 'bi bi-pencil',
                                    onclick: `window.location.href='/Meeting/MeetingAddEdit/${meetingId}'`
                                },
                                {
                                    text: 'View Members',
                                    class: 'btn-info',
                                    icon: 'bi bi-people',
                                    onclick: `window.location.href='/MeetingMembers/MeetingMemberList?meetingId=${meetingId}'`
                                },
                                {
                                    text: 'Close',
                                    class: 'btn-secondary',
                                    onclick: 'modernUI.closeModal()'
                                }
                            ]
                        });
                    } else {
                        modernUI.showToast({
                            title: 'Error',
                            message: data.message || 'Failed to load meeting details',
                            type: 'error'
                        });
                    }
                })
                .catch(error => {
                    if (button) {
                        modernUI.resetButton(button);
                    }
                    console.error('Error loading meeting details:', error);
                    modernUI.showToast({
                        title: 'Error',
                        message: 'Failed to load meeting details. Please try again.',
                        type: 'error'
                    });
                });
        }
                                    </div>
                                    ${data.document ? `
                                        <div class="col-12">
                                            <strong>Document:</strong><br>
                                            <a href="${data.document}" target="_blank" class="text-primary">
                                                <i class="bi bi-file-earmark-text me-1"></i>View Document
                                            </a>
                                        </div>
                                    ` : ''}
                                </div>
                            </div>
                        `;
                        document.querySelector('#customModal .custom-modal-body').innerHTML = content;
                    }
                })
                .catch(error => {
                    console.error('Error loading meeting details:', error);
                    document.querySelector('#customModal .custom-modal-body').innerHTML = 
                        '<div class="alert alert-danger">Error loading meeting details.</div>';
                });
        }

        // Cancel meeting
        function cancelMeeting(meetingId) {
            modernUI.showModal({
                title: 'Cancel Meeting',
                content: `
                    <form id="cancelMeetingForm">
                        <div class="mb-3">
                            <label class="form-label">Cancellation Reason <span class="text-danger">*</span></label>
                            <textarea name="reason" class="form-control" rows="3" required 
                                      placeholder="Please provide a reason for cancelling this meeting..."></textarea>
                        </div>
                    </form>
                `,
                buttons: [
                    {
                        text: 'Cancel Meeting',
                        class: 'btn-warning',
                        onclick: `submitCancelMeeting(${meetingId})`
                    },
                    {
                        text: 'Close',
                        class: 'btn-secondary'
                    }
                ]
            });
        }

        function submitCancelMeeting(meetingId) {
            const form = document.getElementById('cancelMeetingForm');
            const reason = form.reason.value.trim();
            
            if (!reason) {
                modernUI.showToast('Please provide a cancellation reason', 'error');
                return;
            }

            // Submit cancellation
            const formData = new FormData();
            formData.append('id', meetingId);
            formData.append('reason', reason);

            fetch('/Meeting/CancelMeeting', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    modernUI.closeModal();
                    modernUI.showToast('Meeting cancelled successfully', 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    modernUI.showToast(data.message || 'Error cancelling meeting', 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                modernUI.showToast('Error cancelling meeting', 'error');
            });
        }

        // Delete meeting
        function deleteMeeting(meetingId) {
            modernUI.showConfirmation({
                title: 'Delete Meeting',
                message: `Are you sure you want to delete this meeting?<br><small class="text-muted">This action cannot be undone.</small>`,
                confirmText: 'Delete Meeting',
                confirmClass: 'btn-danger',
                onConfirm: () => {
                    window.location.href = `/Meeting/DeleteMeeting/${meetingId}`;
                }
            });
        }

        // Auto-hide alerts
        modernUI.autoHideAlerts();
    </script>
}
