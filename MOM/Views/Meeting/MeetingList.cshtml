@model System.Data.DataTable

@{
    ViewData["Title"] = "Meeting List";
    var search = ViewBag.Search as string ?? "";
    var totalRecords = ViewBag.TotalRecords as int? ?? 0;
    var filteredRecords = Model.Rows.Count;

    string GetValue(System.Data.DataRow row, string col)
    {
        return Model.Columns.Contains(col) ? row[col]?.ToString() ?? "" : "";
    }

    bool GetBool(System.Data.DataRow row, string col)
    {
        return Model.Columns.Contains(col) && row[col] != DBNull.Value && Convert.ToBoolean(row[col]);
    }

    DateTime GetDate(System.Data.DataRow row, string col)
    {
        return Model.Columns.Contains(col) && row[col] != DBNull.Value
            ? Convert.ToDateTime(row[col])
            : DateTime.MinValue;
    }

    int GetInt(System.Data.DataRow row, string col)
    {
        return Model.Columns.Contains(col) && row[col] != DBNull.Value
            ? Convert.ToInt32(row[col])
            : 0;
    }
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-calendar-event me-2"></i>Meeting Management</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Meetings</li>
                </ol>
            </nav>
        </div>
        <a asp-action="MeetingAddEdit" class="btn btn-light">
            <i class="bi bi-plus-lg me-1"></i>
            Schedule Meeting
        </a>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-hover">
                <div class="card-body">
                    <!-- Header with Stats -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h5 class="card-title mb-1">
                                <i class="bi bi-calendar-event text-primary me-2"></i>
                                Meeting Management
                            </h5>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Showing @filteredRecords of @totalRecords meetings
                            </p>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="modernUI.exportTable('#meetingTable', 'meetings', 'csv')">
                                <i class="bi bi-file-earmark-excel me-1"></i>
                                Export
                            </button>
                            <a asp-action="MeetingAddEdit" class="btn btn-primary">
                                <i class="bi bi-plus-lg me-1"></i>
                                Schedule Meeting
                            </a>
                        </div>
                    </div>

                    <!-- Search and Filter Section -->
                    <div class="filter-section">
                        <form method="get" class="row g-3">
                            <input type="hidden" name="page" value="1" />
                            
                            <div class="col-md-3">
                                <label class="form-label">Search Meetings</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text" 
                                           name="search" 
                                           value="@search" 
                                           class="form-control" 
                                           placeholder="Search meetings..." />
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-search me-1"></i>Search
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Status</label>
                                <select name="statusFilter" class="form-select">
                                    <option value="">All Status</option>
                                    <option value="Upcoming" selected="@(ViewBag.StatusFilter == "Upcoming")">Upcoming</option>
                                    <option value="Today" selected="@(ViewBag.StatusFilter == "Today")">Today</option>
                                    <option value="Past" selected="@(ViewBag.StatusFilter == "Past")">Past</option>
                                    <option value="Cancelled" selected="@(ViewBag.StatusFilter == "Cancelled")">Cancelled</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Department</label>
                                <select name="departmentFilter" class="form-select">
                                    <option value="">All Departments</option>
                                    @foreach (System.Data.DataRow dept in ViewBag.Departments.Rows)
                                    {
                                        <option value="@dept["DepartmentID"]" 
                                                selected="@(ViewBag.DepartmentFilter.ToString() == dept["DepartmentID"].ToString())">
                                            @dept["DepartmentName"]
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Type</label>
                                <select name="typeFilter" class="form-select">
                                    <option value="">All Types</option>
                                    @foreach (System.Data.DataRow type in ViewBag.MeetingTypes.Rows)
                                    {
                                        <option value="@type["MeetingTypeID"]" 
                                                selected="@(ViewBag.TypeFilter.ToString() == type["MeetingTypeID"].ToString())">
                                            @type["MeetingTypeName"]
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Venue</label>
                                <select name="venueFilter" class="form-select">
                                    <option value="">All Venues</option>
                                    @foreach (System.Data.DataRow venue in ViewBag.MeetingVenues.Rows)
                                    {
                                        <option value="@venue["MeetingVenueID"]" 
                                                selected="@(ViewBag.VenueFilter.ToString() == venue["MeetingVenueID"].ToString())">
                                            @venue["MeetingVenueName"]
                                        </option>
                                    }
                                </select>
                            </div>
                            
                            <div class="col-md-1 d-flex align-items-end">
                                @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(ViewBag.StatusFilter as string) || ViewBag.DepartmentFilter.ToString() != "0" || ViewBag.TypeFilter.ToString() != "0" || ViewBag.VenueFilter.ToString() != "0")
                                {
                                    <a href="@Url.Action("MeetingList")" class="btn btn-outline-secondary w-100">
                                        <i class="bi bi-x-lg me-1"></i>Clear
                                    </a>
                                }
                            </div>
                        </form>
                    </div>

                    <!-- Data Table -->
                    <div class="table-container">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle" id="meetingTable">
                                <thead>
                                    <tr>
                                        <th>Meeting Details</th>
                                        <th>Date & Time</th>
                                        <th>Type & Venue</th>
                                        <th>Department</th>
                                        <th>Members</th>
                                        <th>Status</th>
                                        <th class="text-center" style="width: 200px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Rows.Count > 0)
                                    {
                                        @foreach (System.Data.DataRow row in Model.Rows)
                                        {
                                            bool isCancelled = GetBool(row, "IsCancelled");
                                            DateTime date = GetDate(row, "MeetingDate");
                                            int memberCount = GetInt(row, "MemberCount");
                                            int presentCount = GetInt(row, "PresentCount");

                                            string status =
                                            isCancelled ? "Cancelled" :
                                            date.Date == DateTime.Today ? "Today" :
                                            date > DateTime.Now ? "Upcoming" :
                                            "Past";

                                            int meetingId = GetInt(row, "MeetingID");
                                            string description = GetValue(row, "MeetingDescription");
                                            string type = GetValue(row, "MeetingTypeName");
                                            string venue = GetValue(row, "VenueName");
                                            string dept = GetValue(row, "DepartmentName");
                                            string docPath = GetValue(row, "DocumentPath");

                                            <tr class="@(isCancelled ? "table-muted" : "")">
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar bg-primary me-3">
                                                            <i class="bi bi-calendar-event"></i>
                                                        </div>
                                                        <div>
                                                            <h6 class="mb-0 fw-semibold">@description</h6>
                                                            <small class="text-muted">ID: @meetingId</small>
                                                            @if (!string.IsNullOrEmpty(docPath))
                                                            {
                                                                <div class="mt-1">
                                                                    <a href="@docPath" target="_blank" class="text-primary small">
                                                                        <i class="bi bi-file-earmark-text me-1"></i>Document
                                                                    </a>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div>
                                                        <span class="fw-medium">
                                                            @(date == DateTime.MinValue ? "" : date.ToString("dd MMM yyyy"))
                                                        </span>
                                                        <br>
                                                        <small class="text-muted">
                                                            @(date == DateTime.MinValue ? "" : date.ToString("hh:mm tt"))
                                                        </small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex flex-column gap-1">
                                                        <span class="badge bg-info">@type</span>
                                                        <span class="badge bg-secondary">@venue</span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-primary">@dept</span>
                                                </td>
                                                <td>
                                                    @if (memberCount > 0)
                                                    {
                                                        <div class="d-flex flex-column gap-1">
                                                            <span class="badge bg-info">@memberCount Total</span>
                                                            <span class="badge bg-success">@presentCount Present</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No members</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (status == "Cancelled")
                                                    {
                                                        <span class="badge bg-danger">Cancelled</span>
                                                    }
                                                    else if (status == "Today")
                                                    {
                                                        <span class="badge bg-warning">Today</span>
                                                    }
                                                    else if (status == "Upcoming")
                                                    {
                                                        <span class="badge bg-success">Upcoming</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Past</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group" role="group">
                                                        <button type="button" 
                                                                class="btn btn-outline-info btn-sm" 
                                                                onclick="viewMeeting(@meetingId)"
                                                                title="View Details">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <a asp-action="MeetingAddEdit" asp-route-id="@meetingId"
                                                           class="btn btn-outline-primary btn-sm" 
                                                           title="Edit Meeting">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>

                                                        @if (!isCancelled && date > DateTime.Now)
                                                        {
                                                            <button type="button" 
                                                                    class="btn btn-outline-warning btn-sm" 
                                                                    onclick="cancelMeeting(@meetingId)" 
                                                                    title="Cancel Meeting">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        }

                                                        @if (!isCancelled || memberCount == 0)
                                                        {
                                                            <button type="button" 
                                                                    class="btn btn-outline-danger btn-sm" 
                                                                    onclick="deleteMeeting(@meetingId)" 
                                                                    title="Delete Meeting">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7">
                                                <div class="empty-state">
                                                    <i class="bi bi-calendar-x"></i>
                                                    @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(ViewBag.StatusFilter as string) || ViewBag.DepartmentFilter.ToString() != "0")
                                                    {
                                                        <h3>No meetings found</h3>
                                                        <p>No meetings match your search criteria</p>
                                                        <a href="@Url.Action("MeetingList")" class="btn btn-outline-primary">
                                                            <i class="bi bi-arrow-left me-1"></i>Clear Filters
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <h3>No meetings yet</h3>
                                                        <p>Get started by scheduling your first meeting</p>
                                                        <a asp-action="MeetingAddEdit" class="btn btn-primary">
                                                            <i class="bi bi-plus-lg me-1"></i>Schedule First Meeting
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Pagination -->
                    @if (ViewBag.TotalPages > 1)
                    {
                        <div class="pagination-wrapper">
                            <nav aria-label="Meeting pagination">
                                <ul class="pagination">
                                    @if (ViewBag.CurrentPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("MeetingList", new { 
                                                page = ViewBag.CurrentPage - 1, 
                                                search = ViewBag.Search,
                                                statusFilter = ViewBag.StatusFilter,
                                                departmentFilter = ViewBag.DepartmentFilter,
                                                typeFilter = ViewBag.TypeFilter,
                                                venueFilter = ViewBag.VenueFilter,
                                                dateFrom = ViewBag.DateFrom,
                                                dateTo = ViewBag.DateTo,
                                                pageSize = ViewBag.PageSize
                                            })">
                                                <i class="bi bi-chevron-left"></i>
                                            </a>
                                        </li>
                                    }

                                    @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                                    {
                                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("MeetingList", new { 
                                                page = i, 
                                                search = ViewBag.Search,
                                                statusFilter = ViewBag.StatusFilter,
                                                departmentFilter = ViewBag.DepartmentFilter,
                                                typeFilter = ViewBag.TypeFilter,
                                                venueFilter = ViewBag.VenueFilter,
                                                dateFrom = ViewBag.DateFrom,
                                                dateTo = ViewBag.DateTo,
                                                pageSize = ViewBag.PageSize
                                            })">@i</a>
                                        </li>
                                    }

                                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("MeetingList", new { 
                                                page = ViewBag.CurrentPage + 1, 
                                                search = ViewBag.Search,
                                                statusFilter = ViewBag.StatusFilter,
                                                departmentFilter = ViewBag.DepartmentFilter,
                                                typeFilter = ViewBag.TypeFilter,
                                                venueFilter = ViewBag.VenueFilter,
                                                dateFrom = ViewBag.DateFrom,
                                                dateTo = ViewBag.DateTo,
                                                pageSize = ViewBag.PageSize
                                            })">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</section>



@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        // View meeting details
        function viewMeeting(meetingId) {
            console.log('viewMeeting called with ID:', meetingId);
            const button = document.querySelector(`button[onclick="viewMeeting(${meetingId})"]`);
            if (button) {
                modernUI.setButtonLoading(button, 'Loading...');
            }
            
            fetch(`/Meeting/GetMeetingDetails?id=${meetingId}`)
                .then(response => {
                    console.log('Response status:', response.status);
                    return response.json();
                })
                .then(data => {
                    console.log('Response data:', data);
                    if (button) {
                        modernUI.resetButton(button);
                    }
                    
                    if (data.success) {
                        const meeting = data.data;
                        console.log('Meeting data:', meeting);
                        
                        // Helper function to safely get values
                        const safeValue = (value, defaultValue = 'N/A') => {
                            return (value !== null && value !== undefined && value !== '') ? value : defaultValue;
                        };
                        
                        modernUI.showModal({
                            title: `<i class="bi bi-calendar-event me-2"></i>Meeting Details`,
                            size: 'lg',
                            content: `
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title text-primary mb-3">
                                                    <i class="bi bi-info-circle me-1"></i>Meeting Information
                                                </h6>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Description:</strong></div>
                                                    <div class="col-sm-7">${safeValue(meeting.meetingDescription)}</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Date & Time:</strong></div>
                                                    <div class="col-sm-7">${safeValue(meeting.meetingDate)}</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Type:</strong></div>
                                                    <div class="col-sm-7"><span class="badge bg-info">${safeValue(meeting.meetingTypeName)}</span></div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-5"><strong>Venue:</strong></div>
                                                    <div class="col-sm-7">${safeValue(meeting.meetingVenueName)}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title text-success mb-3">
                                                    <i class="bi bi-bar-chart me-1"></i>Status & Statistics
                                                </h6>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Department:</strong></div>
                                                    <div class="col-sm-7"><span class="badge bg-secondary">${safeValue(meeting.departmentName)}</span></div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Status:</strong></div>
                                                    <div class="col-sm-7"><span class="badge bg-${meeting.statusClass || 'primary'}">${safeValue(meeting.status, 'Scheduled')}</span></div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-5"><strong>Members:</strong></div>
                                                    <div class="col-sm-7">
                                                        <span class="badge bg-success">${safeValue(meeting.memberCount, '0')} total</span>
                                                        <span class="badge bg-info ms-1">${safeValue(meeting.presentCount, '0')} present</span>
                                                    </div>
                                                </div>
                                                ${meeting.documentPath ? `
                                                    <div class="row mt-2">
                                                        <div class="col-sm-5"><strong>Document:</strong></div>
                                                        <div class="col-sm-7">
                                                            <a href="${meeting.documentPath}" target="_blank" class="text-primary">
                                                                <i class="bi bi-file-earmark-text me-1"></i>View Document
                                                            </a>
                                                        </div>
                                                    </div>
                                                ` : ''}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `,
                            buttons: [
                                {
                                    text: 'Edit Meeting',
                                    class: 'btn-primary',
                                    icon: 'bi bi-pencil',
                                    onclick: `window.location.href='/Meeting/MeetingAddEdit/${meetingId}'`
                                },
                                {
                                    text: 'View Members',
                                    class: 'btn-info',
                                    icon: 'bi bi-people',
                                    onclick: `window.location.href='/MeetingMembers/MeetingMemberList?meetingId=${meetingId}'`
                                },
                                {
                                    text: 'Close',
                                    class: 'btn-secondary',
                                    onclick: 'modernUI.closeModal()'
                                }
                            ]
                        });
                    } else {
                        modernUI.showToast({
                            title: 'Error',
                            message: data.message || 'Failed to load meeting details',
                            type: 'error'
                        });
                    }
                })
                .catch(error => {
                    console.error('Error loading meeting details:', error);
                    if (button) {
                        modernUI.resetButton(button);
                    }
                    modernUI.showToast({
                        title: 'Error',
                        message: 'Failed to load meeting details. Please try again.',
                        type: 'error'
                    });
                });
        }

        // Cancel meeting
        function cancelMeeting(meetingId) {
            modernUI.showModal({
                title: 'Cancel Meeting',
                content: `
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Are you sure you want to cancel this meeting?</strong>
                        <p class="mb-0 mt-2">This action will mark the meeting as cancelled and notify all participants.</p>
                    </div>
                    <form id="cancelMeetingForm">
                        <div class="mb-3">
                            <label class="form-label">
                                Cancellation Reason <span class="text-muted">(Optional)</span>
                            </label>
                            <textarea name="reason" class="form-control" rows="3" maxlength="250"
                                      placeholder="Provide a reason for cancellation (optional)..." 
                                      oninput="updateCharacterCount(this)"></textarea>
                            <div class="d-flex justify-content-between">
                                <div class="form-text">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Providing a reason helps participants understand why the meeting was cancelled.
                                </div>
                                <small class="text-muted" id="charCount">0/250</small>
                            </div>
                        </div>
                    </form>
                `,
                buttons: [
                    {
                        text: 'Cancel Meeting',
                        class: 'btn-warning',
                        icon: 'bi bi-x-circle',
                        onclick: `submitCancelMeeting(${meetingId})`
                    },
                    {
                        text: 'Keep Meeting',
                        class: 'btn-secondary',
                        onclick: 'modernUI.closeModal()'
                    }
                ]
            });
        }

        function submitCancelMeeting(meetingId) {
            const form = document.getElementById('cancelMeetingForm');
            const reason = form.reason.value.trim();
            
            // Show loading state
            const submitButton = document.querySelector('button[onclick*="submitCancelMeeting"]');
            if (submitButton) {
                modernUI.setButtonLoading(submitButton, 'Cancelling...');
            }

            // Submit cancellation (reason is optional)
            const formData = new FormData();
            formData.append('id', meetingId);
            formData.append('reason', reason); // Can be empty

            fetch('/Meeting/CancelMeeting', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (submitButton) {
                    modernUI.resetButton(submitButton);
                }
                
                if (data.success) {
                    modernUI.closeModal();
                    modernUI.showToast({
                        title: 'Success',
                        message: 'Meeting cancelled successfully',
                        type: 'success'
                    });
                    setTimeout(() => location.reload(), 1500);
                } else {
                    modernUI.showToast({
                        title: 'Error',
                        message: data.message || 'Error cancelling meeting',
                        type: 'error'
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                if (submitButton) {
                    modernUI.resetButton(submitButton);
                }
                modernUI.showToast({
                    title: 'Error',
                    message: 'Error cancelling meeting. Please try again.',
                    type: 'error'
                });
            });
        }

        // Character count helper for cancellation reason
        function updateCharacterCount(textarea) {
            const charCount = document.getElementById('charCount');
            if (charCount) {
                const count = textarea.value.length;
                charCount.textContent = `${count}/250`;
                
                if (count > 200) {
                    charCount.className = 'text-warning';
                } else if (count > 240) {
                    charCount.className = 'text-danger';
                } else {
                    charCount.className = 'text-muted';
                }
            }
        }

        // Delete meeting
        function deleteMeeting(meetingId) {
            console.log('deleteMeeting called with ID:', meetingId);
            modernUI.showConfirmation({
                title: 'Delete Meeting',
                message: `Are you sure you want to delete this meeting?<br><small class="text-muted">This action cannot be undone.</small>`,
                confirmText: 'Delete Meeting',
                confirmClass: 'btn-danger',
                onConfirm: () => {
                    console.log('Delete confirmed for meeting ID:', meetingId);
                    fetch('/Meeting/Delete', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: `id=${meetingId}`
                    })
                    .then(response => {
                        console.log('Delete response status:', response.status);
                        return response.json();
                    })
                    .then(data => {
                        console.log('Delete response data:', data);
                        if (data.success) {
                            modernUI.showToast({
                                title: 'Success',
                                message: data.message || 'Meeting deleted successfully',
                                type: 'success'
                            });
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            modernUI.showToast({
                                title: 'Error',
                                message: data.message || 'Failed to delete meeting',
                                type: 'error'
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Error deleting meeting:', error);
                        modernUI.showToast({
                            title: 'Error',
                            message: 'Failed to delete meeting',
                            type: 'error'
                        });
                    });
                }
            });
        }

        // Initialize live search
        document.addEventListener('DOMContentLoaded', function() {
            modernUI.setupLiveSearch('input[name="search"]', '#meetingTable');
        });
    </script>
}
