@model MOM.Models.MeetingModel

@{
    bool isEdit = Model.MeetingID > 0;
    ViewData["Title"] = isEdit ? "Edit Meeting" : "Schedule Meeting";
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-calendar-plus me-2"></i>@(isEdit ? "Edit Meeting" : "Schedule Meeting")</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-action="MeetingList">Meetings</a></li>
                    <li class="breadcrumb-item active">@(isEdit ? "Edit" : "Schedule")</li>
                </ol>
            </nav>
        </div>
        <a asp-action="MeetingList" class="btn btn-light">
            <i class="bi bi-arrow-left me-1"></i>
            Back to List
        </a>
    </div>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-hover">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <div class="avatar bg-primary me-3">
                            <i class="bi bi-calendar-plus"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 text-white">
                                @(isEdit ? "Edit Meeting Details" : "Schedule New Meeting")
                            </h5>
                            <p class="mb-0 text-white-50 small">
                                @(isEdit ? "Update meeting information and settings" : "Create a new meeting with all details")
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Display validation summary -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <h6><i class="bi bi-exclamation-triangle me-1"></i>Please correct the following errors:</h6>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <form asp-action="MeetingAddEdit" method="post" enctype="multipart/form-data" id="meetingForm" novalidate>
                        <input type="hidden" asp-for="MeetingID" />
                        <input type="hidden" asp-for="Created" />
                        <input type="hidden" name="DocumentPath" value="@Model.DocumentPath" />

                        <div class="row g-4">
                            <!-- Meeting Date & Time -->
                            <div class="col-md-6">
                                <label asp-for="MeetingDate" class="form-label">
                                    <i class="bi bi-calendar-date me-1"></i>Meeting Date & Time <span class="text-danger">*</span>
                                </label>
                                <input asp-for="MeetingDate" type="datetime-local" class="form-control form-control-modern" 
                                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="MeetingDate" class="text-danger"></span>
                                <div class="form-text">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Select future date and time for the meeting
                                </div>
                            </div>

                            <!-- Department -->
                            <div class="col-md-6">
                                <label asp-for="DepartmentID" class="form-label">
                                    <i class="bi bi-building me-1"></i>Department <span class="text-danger">*</span>
                                </label>
                                <select asp-for="DepartmentID" class="form-select form-control-modern">
                                    <option value="">-- Select Department --</option>
                                    @foreach (System.Data.DataRow dept in ViewBag.Departments.Rows)
                                    {
                                        <option value="@dept["DepartmentID"]">@dept["DepartmentName"]</option>
                                    }
                                </select>
                                <span asp-validation-for="DepartmentID" class="text-danger"></span>
                            </div>

                            <!-- Meeting Type -->
                            <div class="col-md-6">
                                <label asp-for="MeetingTypeID" class="form-label">
                                    <i class="bi bi-tag me-1"></i>Meeting Type <span class="text-danger">*</span>
                                </label>
                                <select asp-for="MeetingTypeID" class="form-select form-control-modern">
                                    <option value="">-- Select Meeting Type --</option>
                                    @foreach (System.Data.DataRow type in ViewBag.MeetingTypes.Rows)
                                    {
                                        <option value="@type["MeetingTypeID"]">@type["MeetingTypeName"]</option>
                                    }
                                </select>
                                <span asp-validation-for="MeetingTypeID" class="text-danger"></span>
                            </div>

                            <!-- Venue -->
                            <div class="col-md-6">
                                <label asp-for="MeetingVenueID" class="form-label">
                                    <i class="bi bi-geo-alt me-1"></i>Meeting Venue <span class="text-danger">*</span>
                                </label>
                                <select asp-for="MeetingVenueID" class="form-select form-control-modern">
                                    <option value="">-- Select Venue --</option>
                                    @foreach (System.Data.DataRow venue in ViewBag.MeetingVenues.Rows)
                                    {
                                        <option value="@venue["MeetingVenueID"]">@venue["MeetingVenueName"]</option>
                                    }
                                </select>
                                <span asp-validation-for="MeetingVenueID" class="text-danger"></span>
                            </div>

                            <!-- Meeting Description -->
                            <div class="col-12">
                                <label asp-for="MeetingDescription" class="form-label">
                                    <i class="bi bi-card-text me-1"></i>Meeting Description
                                </label>
                                <textarea asp-for="MeetingDescription" class="form-control form-control-modern" rows="4" 
                                          placeholder="Enter meeting agenda, objectives, or description..." maxlength="250"></textarea>
                                <span asp-validation-for="MeetingDescription" class="text-danger"></span>
                                <div class="form-text">Maximum 250 characters</div>
                            </div>

                            <!-- Document Upload -->
                            <div class="col-md-8">
                                <label class="form-label">
                                    <i class="bi bi-file-earmark-arrow-up me-1"></i>Meeting Document <span class="text-muted">(Optional)</span>
                                </label>
                                <div class="file-upload-wrapper">
                                    <input type="file" name="upload" class="form-control form-control-modern" 
                                           accept=".pdf,.doc,.docx,.xls,.xlsx" />
                                    <div class="form-text">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Upload agenda, presentation, or related documents (PDF, DOC, DOCX, XLS, XLSX - Max 10MB)
                                    </div>
                                </div>
                                
                                @if (isEdit && !string.IsNullOrEmpty(Model.DocumentPath))
                                {
                                    <div class="current-document mt-3">
                                        <div class="alert alert-info">
                                            <i class="bi bi-file-earmark-text me-2"></i>
                                            <strong>Current Document:</strong>
                                            <a href="@Model.DocumentPath" target="_blank" class="btn btn-sm btn-outline-primary ms-2">
                                                <i class="bi bi-eye me-1"></i>View Document
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Meeting Status -->
                            <div class="col-md-4">
                                <label class="form-label">
                                    <i class="bi bi-check-circle me-1"></i>Meeting Status
                                </label>
                                <div class="form-check form-switch form-switch-modern">
                                    <input asp-for="IsCancelled" class="form-check-input" type="checkbox" id="isCancelledSwitch">
                                    <label class="form-check-label" for="isCancelledSwitch">
                                        <span id="statusLabel">@(Model.IsCancelled ? "Cancelled" : "Active")</span>
                                    </label>
                                </div>
                                <div class="form-text">Toggle to mark meeting as cancelled</div>
                            </div>

                            <!-- Cancellation Details (shown when cancelled) -->
                            <div id="cancellationDetails" class="col-12" style="display: @(Model.IsCancelled ? "block" : "none")">
                                <div class="info-card info-card-warning">
                                    <h6 class="info-card-title">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Cancellation Details
                                    </h6>
                                    <div class="info-card-content">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label asp-for="CancellationDateTime" class="form-label">Cancellation Date & Time</label>
                                                <input asp-for="CancellationDateTime" type="datetime-local" class="form-control form-control-modern" />
                                                <span asp-validation-for="CancellationDateTime" class="text-danger"></span>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">
                                                    Cancellation Reason <span class="text-muted">(Optional)</span>
                                                </label>
                                                <input name="CancellationReason" value="@Model.CancellationReason" class="form-control form-control-modern" 
                                                       placeholder="Reason for cancellation..." maxlength="250" />
                                                <div class="form-text">Provide reason if needed for record keeping</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="form-actions">
                            <div class="d-flex justify-content-between align-items-center">
                                <a asp-action="MeetingList" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-1"></i>Back to List
                                </a>
                                
                                <div class="d-flex gap-2">
                                    <button type="reset" class="btn btn-outline-secondary">
                                        <i class="bi bi-arrow-clockwise me-1"></i>Reset
                                    </button>
                                    <button type="submit" class="btn btn-primary" id="submitBtn">
                                        <i class="bi bi-check-lg me-1"></i>
                                        @(isEdit ? "Update Meeting" : "Schedule Meeting")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Meeting Guidelines Sidebar -->
        <div class="col-lg-4">
            <div class="card shadow-hover">
                <div class="card-header">
                    <h6 class="mb-0 text-white">
                        <i class="bi bi-info-circle me-1"></i>Meeting Guidelines
                    </h6>
                </div>
                <div class="card-body">
                    <div class="guidelines-panel tips">
                        <div class="guidelines-header">
                            <i class="bi bi-lightbulb"></i>
                            Tips for Effective Meetings
                        </div>
                        <div class="guidelines-content">
                            <ul>
                                <li>Schedule meetings at least 24 hours in advance</li>
                                <li>Provide clear agenda and objectives</li>
                                <li>Choose appropriate venue based on attendee count</li>
                                <li>Upload relevant documents before the meeting</li>
                                <li>Send invitations to all required participants</li>
                            </ul>
                        </div>
                    </div>

                    <div class="guidelines-panel warning">
                        <div class="guidelines-header">
                            <i class="bi bi-exclamation-triangle"></i>
                            Important Notes
                        </div>
                        <div class="guidelines-content">
                            <ul>
                                <li><strong>Meetings cannot be scheduled in the past</strong></li>
                                <li>Check venue availability before scheduling</li>
                                <li>Document upload is optional but recommended</li>
                                <li>Cancellation reason is optional for record keeping</li>
                                <li>Maximum file size for documents: 10MB</li>
                                <li>Supported formats: PDF, DOC, DOCX, XLS, XLSX</li>
                            </ul>
                        </div>
                    </div>

                    @if (isEdit)
                    {
                        <div class="info-card">
                            <h6 class="info-card-title">
                                <i class="bi bi-clock-history me-1"></i>Meeting History
                            </h6>
                            <div class="info-card-content">
                                <div class="info-item">
                                    <span class="info-label">Created:</span>
                                    <span class="info-value">@Model.Created.ToString("MMM dd, yyyy hh:mm tt")</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">Last Modified:</span>
                                    <span class="info-value">@Model.Modified.ToString("MMM dd, yyyy hh:mm tt")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow-hover">
                <div class="card-header">
                    <h6 class="mb-0 text-white">
                        <i class="bi bi-lightning me-1"></i>Quick Actions
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="MeetingList" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-list me-1"></i>View All Meetings
                        </a>
                        <a asp-controller="MeetingMembers" asp-action="MeetingMemberList" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-people me-1"></i>Manage Members
                        </a>
                        @if (isEdit)
                        {
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="assignMembers()">
                                <i class="bi bi-person-plus me-1"></i>Assign Members
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize modern form validation
            modernUI.initializeFormValidation('#meetingForm', {
                'MeetingDate': {
                    required: true,
                    messages: {
                        required: 'Meeting date and time is required'
                    }
                },
                'DepartmentID': {
                    required: true,
                    messages: {
                        required: 'Please select a department'
                    }
                },
                'MeetingTypeID': {
                    required: true,
                    messages: {
                        required: 'Please select a meeting type'
                    }
                },
                'MeetingVenueID': {
                    required: true,
                    messages: {
                        required: 'Please select a meeting venue'
                    }
                },
                'MeetingDescription': {
                    maxLength: 250,
                    messages: {
                        maxLength: 'Description cannot exceed 250 characters'
                    }
                },
                'CancellationReason': {
                    required: false,
                    maxLength: 250,
                    messages: {
                        maxLength: 'Cancellation reason cannot exceed 250 characters'
                    }
                }
            });

            // Form submission with loading state
            const form = document.getElementById('meetingForm');
            const submitBtn = document.getElementById('submitBtn');
            
            form.addEventListener('submit', function(e) {
                if (!modernUI.validateForm('#meetingForm')) {
                    e.preventDefault();
                    return false;
                }
                
                // Show loading state
                modernUI.setButtonLoading(submitBtn, 'Saving...');
            });

            // Character counter for description
            const descriptionField = document.querySelector('textarea[name="MeetingDescription"]');
            if (descriptionField) {
                modernUI.initializeCharacterCounter(descriptionField, 250);
            }

            // Character counter for cancellation reason
            const cancellationReasonField = document.querySelector('input[name="CancellationReason"]');
            if (cancellationReasonField) {
                modernUI.initializeCharacterCounter(cancellationReasonField, 250);
            }
        });

        // Toggle cancellation details and status label
        document.getElementById('isCancelledSwitch').addEventListener('change', function() {
            const cancellationDetails = document.getElementById('cancellationDetails');
            const cancellationDateTime = document.querySelector('input[name="CancellationDateTime"]');
            const statusLabel = document.getElementById('statusLabel');
            
            if (this.checked) {
                cancellationDetails.style.display = 'block';
                statusLabel.textContent = 'Cancelled';
                statusLabel.className = 'text-danger';
                
                // Set current date/time as default
                if (!cancellationDateTime.value) {
                    const now = new Date();
                    const localDateTime = new Date(now.getTime() - now.getTimezoneOffset() * 60000);
                    cancellationDateTime.value = localDateTime.toISOString().slice(0, 16);
                }
            } else {
                cancellationDetails.style.display = 'none';
                statusLabel.textContent = 'Active';
                statusLabel.className = 'text-success';
                
                // Clear cancellation fields
                cancellationDateTime.value = '';
                document.querySelector('input[name="CancellationReason"]').value = '';
            }
        });

        // Quick action functions
        function assignMembers() {
            @if (isEdit)
            {
                <text>
                window.location.href = '/MeetingMembers/MeetingMemberAddEdit?meetingId=@Model.MeetingID';
                </text>
            }
            else
            {
                <text>
                modernUI.showToast('Please save the meeting first before assigning members', 'info');
                </text>
            }
        }

        // File upload enhancement
        const fileInput = document.querySelector('input[type="file"]');
        if (fileInput) {
            fileInput.addEventListener('change', function() {
                const file = this.files[0];
                if (file) {
                    // Check file size (10MB limit)
                    if (file.size > 10 * 1024 * 1024) {
                        modernUI.showToast('File size cannot exceed 10MB', 'error');
                        this.value = '';
                        return;
                    }
                    
                    // Show file info
                    const fileInfo = document.createElement('div');
                    fileInfo.className = 'alert alert-success mt-2';
                    fileInfo.innerHTML = `
                        <i class="bi bi-file-earmark-check me-1"></i>
                        <strong>Selected:</strong> ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)
                    `;
                    
                    // Remove existing file info
                    const existingInfo = this.parentNode.querySelector('.alert');
                    if (existingInfo && !existingInfo.classList.contains('alert-info')) {
                        existingInfo.remove();
                    }
                    
                    this.parentNode.appendChild(fileInfo);
                }
            });
        }

        
    </script>
}
