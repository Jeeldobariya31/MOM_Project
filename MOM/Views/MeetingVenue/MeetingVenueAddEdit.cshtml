@model MOM.Models.MeetingVenueModel

@{
    ViewData["Title"] = Model.MeetingVenueID > 0 ? "Edit Meeting Venue" : "Add Meeting Venue";
    bool isEdit = Model.MeetingVenueID > 0;
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-geo-alt me-2"></i>@(isEdit ? "Edit Meeting Venue" : "Add Meeting Venue")</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="breadcrumb-item">Master</li>
                    <li class="breadcrumb-item">
                        <a asp-action="MeetingVenueList">Meeting Venues</a>
                    </li>
                    <li class="breadcrumb-item active">@(isEdit ? "Edit" : "Add")</li>
                </ol>
            </nav>
        </div>
        <a asp-action="MeetingVenueList" class="btn btn-light">
            <i class="bi bi-arrow-left me-1"></i>
            Back to List
        </a>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="section">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-hover">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <div class="avatar bg-primary me-3">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 text-white">
                                @(isEdit ? "Edit Meeting Venue" : "Add New Meeting Venue")
                            </h5>
                            <p class="mb-0 text-white-50 small">
                                @(isEdit ? "Update meeting venue information" : "Create a new meeting venue")
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <form asp-action="MeetingVenueAddEdit" method="post" id="venueForm" novalidate>
                        @Html.AntiForgeryToken()
                        
                        <!-- Hidden ID for Edit -->
                        <input type="hidden" asp-for="MeetingVenueID" />
                        <input type="hidden" asp-for="Created" />

                        <div class="row">
                            <div class="col-md-8">
                                <!-- Meeting Venue Name -->
                                <div class="mb-4">
                                    <label asp-for="MeetingVenueName" class="form-label">
                                        <i class="bi bi-geo-alt me-1"></i>
                                        Meeting Venue Name 
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="MeetingVenueName"
                                           class="form-control form-control-modern"
                                           maxlength="100"
                                           placeholder="Enter meeting venue name"
                                           autocomplete="off" />
                                    <span asp-validation-for="MeetingVenueName" class="text-danger small"></span>
                                    <div class="form-text">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Enter a unique meeting venue name (2-100 characters)
                                    </div>
                                </div>
                            </div>

                            @if (isEdit)
                            {
                                <div class="col-md-4">
                                    <!-- Venue Statistics -->
                                    <div class="stats-card">
                                        <div class="stats-card-body">
                                            <div class="stats-icon">
                                                <i class="bi bi-graph-up"></i>
                                            </div>
                                            <div class="stats-content">
                                                <h3 class="stats-number">@Model.MeetingCount</h3>
                                                <p class="stats-label">Total Meetings</p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Audit Information -->
                                    <div class="info-card mt-3">
                                        <h6 class="info-card-title">
                                            <i class="bi bi-clock-history me-1"></i>
                                            Audit Information
                                        </h6>
                                        <div class="info-card-content">
                                            <div class="info-item">
                                                <span class="info-label">Created:</span>
                                                <span class="info-value">@Model.Created.ToString("dd MMM yyyy, hh:mm tt")</span>
                                            </div>
                                            <div class="info-item">
                                                <span class="info-label">Modified:</span>
                                                <span class="info-value">@Model.Modified.ToString("dd MMM yyyy, hh:mm tt")</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Form Actions -->
                        <div class="form-actions">
                            <div class="d-flex justify-content-between align-items-center">
                                <a asp-action="MeetingVenueList" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-1"></i>
                                    Back to List
                                </a>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-outline-secondary" onclick="resetForm()">
                                        <i class="bi bi-arrow-clockwise me-1"></i>
                                        Reset
                                    </button>
                                    <button type="submit" class="btn btn-primary" id="submitBtn">
                                        <i class="bi bi-@(isEdit ? "check" : "plus")-lg me-1"></i>
                                        @(isEdit ? "Update Venue" : "Save Venue")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            @if (isEdit && Model.MeetingCount > 0)
            {
                <!-- Related Information -->
                <div class="card shadow-hover mt-4">
                    <div class="card-header">
                        <h6 class="mb-0 text-white">
                            <i class="bi bi-link-45deg me-1"></i>
                            Related Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-calendar-event-fill text-info fs-4 me-3"></i>
                                <div>
                                    <h6 class="mb-0">@Model.MeetingCount Meetings</h6>
                                    <small class="text-muted">Associated with this venue</small>
                                </div>
                            </div>
                        </div>
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <strong>Note:</strong> This venue cannot be deleted as it has associated meetings.
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Guidelines Sidebar -->
        <div class="col-lg-4">
            <div class="card shadow-hover">
                <div class="card-header">
                    <h6 class="mb-0 text-white">
                        <i class="bi bi-info-circle me-1"></i>Venue Guidelines
                    </h6>
                </div>
                <div class="card-body">
                    <div class="guidelines-panel tips">
                        <div class="guidelines-header">
                            <i class="bi bi-lightbulb"></i>
                            Best Practices
                        </div>
                        <div class="guidelines-content">
                            <ul>
                                <li>Use descriptive venue names (e.g., "Conference Room A")</li>
                                <li>Include location details if helpful</li>
                                <li>Consider capacity and equipment available</li>
                                <li>Use consistent naming conventions</li>
                                <li>Keep names professional and clear</li>
                            </ul>
                        </div>
                    </div>

                    <div class="guidelines-panel warning">
                        <div class="guidelines-header">
                            <i class="bi bi-exclamation-triangle"></i>
                            Important Notes
                        </div>
                        <div class="guidelines-content">
                            <ul>
                                <li><strong>Venue names must be unique</strong></li>
                                <li>Cannot delete venues with scheduled meetings</li>
                                <li>Check availability before scheduling</li>
                                <li>Name length: 2-100 characters</li>
                            </ul>
                        </div>
                    </div>

                    @if (isEdit)
                    {
                        <div class="info-card">
                            <h6 class="info-card-title">
                                <i class="bi bi-clock-history me-1"></i>Venue History
                            </h6>
                            <div class="info-card-content">
                                <div class="info-item">
                                    <span class="info-label">Created:</span>
                                    <span class="info-value">@Model.Created.ToString("MMM dd, yyyy hh:mm tt")</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">Last Modified:</span>
                                    <span class="info-value">@Model.Modified.ToString("MMM dd, yyyy hh:mm tt")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow-hover">
                <div class="card-header">
                    <h6 class="mb-0 text-white">
                        <i class="bi bi-lightning me-1"></i>Quick Actions
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="MeetingVenueList" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-list me-1"></i>View All Venues
                        </a>
                        <a asp-controller="Meeting" asp-action="MeetingList" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-calendar-event me-1"></i>View All Meetings
                        </a>
                        @if (isEdit)
                        {
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="viewVenueMeetings()">
                                <i class="bi bi-calendar-check me-1"></i>View Venue Meetings
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize modern form validation
            modernUI.initializeFormValidation('#venueForm', {
                'MeetingVenueName': {
                    required: true,
                    minLength: 2,
                    maxLength: 100,
                    pattern: /^[a-zA-Z0-9\s&.-]+$/,
                    messages: {
                        required: 'Meeting venue name is required',
                        minLength: 'Name must be at least 2 characters',
                        maxLength: 'Name cannot exceed 100 characters',
                        pattern: 'Only letters, numbers, spaces, &, ., and - are allowed'
                    }
                }
            });

            // Form submission with loading state
            const form = document.getElementById('venueForm');
            const submitBtn = document.getElementById('submitBtn');
            
            form.addEventListener('submit', function(e) {
                if (!modernUI.validateForm('#venueForm')) {
                    e.preventDefault();
                    return false;
                }
                
                // Show loading state
                modernUI.setButtonLoading(submitBtn, 'Saving...');
            });
        });

        function resetForm() {
            modernUI.showConfirmation({
                title: 'Reset Form',
                message: 'Are you sure you want to reset the form? All changes will be lost.',
                confirmText: 'Reset',
                confirmClass: 'btn-warning',
                onConfirm: () => {
                    document.getElementById('venueForm').reset();
                    modernUI.clearFormValidation('#venueForm');
                    modernUI.showToast('Form has been reset', 'info');
                }
            });
        }

        // Quick action functions
        function viewVenueMeetings() {
            @if (isEdit)
            {
                <text>
                window.location.href = '/Meeting/MeetingList?venueFilter=@Model.MeetingVenueID';
                </text>
            }
            else
            {
                <text>
                modernUI.showToast('Please save the venue first', 'info');
                </text>
            }
        }

       
    </script>
}