@{
    ViewData["Title"] = "MOM Dashboard";
    var data = ViewBag.DashboardData;
}

<div class="pagetitle">
    <h1>MOM Dashboard</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section dashboard">
    <div class="row">

        <!-- Left side columns -->
        <div class="col-lg-8">
            <div class="row">

                <!-- Total Meetings Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card sales-card">
                        <div class="card-body">
                            <h5 class="card-title">Total Meetings <span>| All Time</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-calendar-event"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@data.TotalMeetings</h6>
                                    <span class="text-info small pt-1 fw-bold">@data.ThisMonthMeetings</span> 
                                    <span class="text-muted small pt-2 ps-1">this month</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Total Meetings Card -->

                <!-- Departments Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card revenue-card">
                        <div class="card-body">
                            <h5 class="card-title">Departments <span>| Active</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-building"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@data.TotalDepartments</h6>
                                    <span class="text-success small pt-1 fw-bold">@data.TotalStaff</span> 
                                    <span class="text-muted small pt-2 ps-1">staff members</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Departments Card -->

                <!-- Upcoming Meetings Card -->
                <div class="col-xxl-4 col-xl-12">
                    <div class="card info-card customers-card">
                        <div class="card-body">
                            <h5 class="card-title">Upcoming Meetings <span>| Scheduled</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-clock"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@data.UpcomingMeetings</h6>
                                    <span class="text-primary small pt-1 fw-bold">@data.RecentMeetings</span> 
                                    <span class="text-muted small pt-2 ps-1">this week</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Upcoming Meetings Card -->

                <!-- Monthly Meeting Trends Chart -->
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Meeting Trends <span>/Last 6 Months</span></h5>
                            <div id="monthlyTrendsChart"></div>
                            <script>
                                document.addEventListener("DOMContentLoaded", () => {
                                    const monthlyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data.MonthlyTrends));
                                    
                                    new ApexCharts(document.querySelector("#monthlyTrendsChart"), {
                                        series: [{
                                            name: 'Meetings Held',
                                            data: monthlyData.map(item => item.count),
                                        }],
                                        chart: {
                                            height: 350,
                                            type: 'area',
                                            toolbar: { show: false },
                                        },
                                        markers: { size: 4 },
                                        colors: ['#4154f1'],
                                        fill: {
                                            type: "gradient",
                                            gradient: {
                                                shadeIntensity: 1,
                                                opacityFrom: 0.3,
                                                opacityTo: 0.4,
                                                stops: [0, 90, 100]
                                            }
                                        },
                                        dataLabels: { enabled: false },
                                        stroke: { curve: 'smooth', width: 2 },
                                        xaxis: {
                                            categories: monthlyData.map(item => item.month)
                                        },
                                        tooltip: {
                                            x: { format: 'MMM yyyy' },
                                        }
                                    }).render();
                                });
                            </script>
                        </div>
                    </div>
                </div><!-- End Monthly Trends Chart -->

                <!-- Recent Meetings -->
                <div class="col-12">
                    <div class="card recent-sales overflow-auto">
                        <div class="card-body">
                            <h5 class="card-title">Recent Meetings <span>| Last 30 Days</span></h5>
                            <table class="table table-borderless datatable">
                                <thead>
                                    <tr>
                                        <th scope="col">Meeting ID</th>
                                        <th scope="col">Description</th>
                                        <th scope="col">Department</th>
                                        <th scope="col">Date</th>
                                        <th scope="col">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (data.RecentMeetingsData != null)
                                    {
                                        @foreach (var meeting in data.RecentMeetingsData)
                                        {
                                            <tr>
                                                <th scope="row">
                                                    <a asp-controller="Meeting" asp-action="MeetingAddEdit" asp-route-id="@meeting.MeetingID">
                                                        #M@meeting.MeetingID.ToString("000")
                                                    </a>
                                                </th>
                                                <td>@meeting.Description</td>
                                                <td><span class="text-primary">@meeting.DepartmentName</span></td>
                                                <td>@meeting.MeetingDate.ToString("MMM dd, yyyy")</td>
                                                <td>
                                                    @if (meeting.IsCancelled)
                                                    {
                                                        <span class="badge bg-danger">Cancelled</span>
                                                    }
                                                    else if (meeting.MeetingDate > DateTime.Now)
                                                    {
                                                        <span class="badge bg-info">Scheduled</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">Completed</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div><!-- End Recent Meetings -->

                <!-- Quick Actions -->
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Quick Actions <span>| Management</span></h5>
                            <div class="row mb-3">
                                <div class="col-md-3 mb-2">
                                    <a asp-controller="Meeting" asp-action="MeetingAddEdit" class="btn btn-primary w-100">
                                        <i class="bi bi-plus-circle me-2"></i>New Meeting
                                    </a>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <a asp-controller="Department" asp-action="DepartmentAddEdit" class="btn btn-success w-100">
                                        <i class="bi bi-building me-2"></i>Add Department
                                    </a>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <a asp-controller="Staff" asp-action="StaffAddEdit" class="btn btn-info w-100">
                                        <i class="bi bi-person-plus me-2"></i>Add Staff
                                    </a>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <a asp-controller="MeetingVenue" asp-action="MeetingVenueAddEdit" class="btn btn-warning w-100">
                                        <i class="bi bi-geo-alt me-2"></i>Add Venue
                                    </a>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-borderless">
                                    <thead>
                                        <tr>
                                            <th scope="col">Module</th>
                                            <th scope="col">Description</th>
                                            <th scope="col">Total Records</th>
                                            <th scope="col">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><i class="bi bi-calendar-event text-primary me-2"></i><strong>Meetings</strong></td>
                                            <td>Manage all meeting records and minutes</td>
                                            <td class="fw-bold">@data.TotalMeetings</td>
                                            <td><a asp-controller="Meeting" asp-action="MeetingList" class="btn btn-sm btn-outline-primary">View All</a></td>
                                        </tr>
                                        <tr>
                                            <td><i class="bi bi-building text-success me-2"></i><strong>Departments</strong></td>
                                            <td>Organizational departments and divisions</td>
                                            <td class="fw-bold">@data.TotalDepartments</td>
                                            <td><a asp-controller="Department" asp-action="DepartmentList" class="btn btn-sm btn-outline-success">View All</a></td>
                                        </tr>
                                        <tr>
                                            <td><i class="bi bi-people text-info me-2"></i><strong>Staff</strong></td>
                                            <td>Employee records and meeting participants</td>
                                            <td class="fw-bold">@data.TotalStaff</td>
                                            <td><a asp-controller="Staff" asp-action="StaffList" class="btn btn-sm btn-outline-info">View All</a></td>
                                        </tr>
                                        <tr>
                                            <td><i class="bi bi-geo-alt text-warning me-2"></i><strong>Venues</strong></td>
                                            <td>Meeting locations and conference rooms</td>
                                            <td class="fw-bold">@data.TotalVenues</td>
                                            <td><a asp-controller="MeetingVenue" asp-action="MeetingVenueList" class="btn btn-sm btn-outline-warning">View All</a></td>
                                        </tr>
                                        <tr>
                                            <td><i class="bi bi-person-check text-secondary me-2"></i><strong>Members</strong></td>
                                            <td>Meeting participants and attendees</td>
                                            <td class="fw-bold">@data.ActiveMembers</td>
                                            <td><a asp-controller="MeetingMembers" asp-action="MeetingMemberList" class="btn btn-sm btn-outline-secondary">View All</a></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div><!-- End Quick Actions -->

            </div>
        </div><!-- End Left side columns -->

        <!-- Right side columns -->
        <div class="col-lg-4">

            <!-- Statistics Overview -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Statistics Overview <span>| Current</span></h5>
                    <div class="row text-center">
                        <div class="col-6 mb-3">
                            <div class="border rounded p-3">
                                <h4 class="text-primary mb-1">@data.AttendanceRate%</h4>
                                <small class="text-muted">Attendance Rate</small>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="border rounded p-3">
                                <h4 class="text-danger mb-1">@data.CancelledMeetings</h4>
                                <small class="text-muted">Cancelled</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-3">
                                <h4 class="text-success mb-1">@data.ActiveMembers</h4>
                                <small class="text-muted">Active Members</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-3">
                                <h4 class="text-info mb-1">@data.TotalVenues</h4>
                                <small class="text-muted">Venues</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- End Statistics Overview -->

            <!-- Department Distribution -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Meeting Distribution <span>| By Department</span></h5>
                    <div id="departmentChart" style="min-height: 400px;" class="echart"></div>
                    <script>
                        document.addEventListener("DOMContentLoaded", () => {
                            const departmentData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data.DepartmentMeetings));
                            
                            echarts.init(document.querySelector("#departmentChart")).setOption({
                                tooltip: { trigger: 'item' },
                                legend: { top: '5%', left: 'center' },
                                series: [{
                                    name: 'Meetings by Department',
                                    type: 'pie',
                                    radius: ['40%', '70%'],
                                    avoidLabelOverlap: false,
                                    label: { show: false, position: 'center' },
                                    emphasis: {
                                        label: { show: true, fontSize: '18', fontWeight: 'bold' }
                                    },
                                    labelLine: { show: false },
                                    data: departmentData.map(item => ({
                                        value: item.count,
                                        name: item.departmentName
                                    }))
                                }]
                            });
                        });
                    </script>
                </div>
            </div><!-- End Department Distribution -->

            <!-- Meeting Types -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Meeting Types <span>| Distribution</span></h5>
                    <div class="activity">
                        @if (data.MeetingTypeDistribution != null)
                        {
                            @foreach (var type in data.MeetingTypeDistribution)
                            {
                                <div class="activity-item d-flex">
                                    <div class="activite-label">@type.Count</div>
                                    <i class='bi bi-circle-fill activity-badge text-primary align-self-start'></i>
                                    <div class="activity-content">
                                        <strong>@type.MeetingTypeName</strong>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div><!-- End Meeting Types -->

            <!-- Upcoming Meetings -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Upcoming Meetings <span>| Next 5</span></h5>
                    <div class="news">
                        @if (data.UpcomingMeetingsData != null && data.UpcomingMeetingsData.Length > 0)
                        {
                            @foreach (var meeting in data.UpcomingMeetingsData)
                            {
                                <div class="post-item clearfix">
                                    <div class="d-flex align-items-center">
                                        <div class="me-3">
                                            <i class="bi bi-calendar-event text-primary" style="font-size: 1.5rem;"></i>
                                        </div>
                                        <div>
                                            <h6><a asp-controller="Meeting" asp-action="MeetingAddEdit" asp-route-id="@meeting.MeetingID">@meeting.Description</a></h6>
                                            <p class="mb-1 small">@meeting.DepartmentName - @meeting.VenueName</p>
                                            <small class="text-muted">@meeting.MeetingDate.ToString("MMM dd, yyyy HH:mm")</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-3">
                                <i class="bi bi-calendar-x" style="font-size: 2rem;"></i>
                                <p class="mt-2">No upcoming meetings scheduled</p>
                            </div>
                        }
                    </div>
                </div>
            </div><!-- End Upcoming Meetings -->

            <!-- Venue Utilization -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Venue Utilization <span>| Usage</span></h5>
                    @if (data.VenueUtilization != null)
                    {
                        @foreach (var venue in data.VenueUtilization)
                        {
                            var percentage = data.TotalMeetings > 0 ? (double)venue.Count / data.TotalMeetings * 100 : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <span class="small">@venue.VenueName</span>
                                    <span class="small">@venue.Count meetings</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-primary" role="progressbar" 
                                         style="width: @percentage.ToString("F1")%" 
                                         aria-valuenow="@percentage.ToString("F1")" 
                                         aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div><!-- End Venue Utilization -->

        </div><!-- End Right side columns -->

    </div>
</section>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @ViewBag.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}