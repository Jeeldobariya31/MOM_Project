@{
    ViewData["Title"] = "MOM Dashboard";
    var data = ViewBag.DashboardData;
}

<div class="pagetitle">
    <h1>MOM Dashboard</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section dashboard">
    <div class="row">

        <!-- Left side columns -->
        <div class="col-lg-8">
            <div class="row">

                <!-- Total Meetings Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card sales-card">
                        <div class="card-body">
                            <h5 class="card-title">Total Meetings <span>| All Time</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-calendar-event"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@(data?.TotalMeetings ?? 0)</h6>
                                    <span class="text-info small pt-1 fw-bold">@(data?.ThisMonthMeetings ?? 0)</span> 
                                    <span class="text-muted small pt-2 ps-1">this month</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Total Meetings Card -->

                <!-- Departments Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card revenue-card">
                        <div class="card-body">
                            <h5 class="card-title">Departments <span>| Active</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-building"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@(data?.TotalDepartments ?? 0)</h6>
                                    <span class="text-success small pt-1 fw-bold">@(data?.TotalStaff ?? 0)</span> 
                                    <span class="text-muted small pt-2 ps-1">staff members</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Departments Card -->

                <!-- Upcoming Meetings Card -->
                <div class="col-xxl-4 col-xl-12">
                    <div class="card info-card customers-card">
                        <div class="card-body">
                            <h5 class="card-title">Upcoming Meetings <span>| Scheduled</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-clock"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@(data?.UpcomingMeetings ?? 0)</h6>
                                    <span class="text-primary small pt-1 fw-bold">@(data?.RecentMeetings ?? 0)</span> 
                                    <span class="text-muted small pt-2 ps-1">this week</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Upcoming Meetings Card -->

                <!-- Monthly Meeting Trends Chart -->
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Meeting Trends <span>/Last 6 Months</span></h5>
                            
                            <div id="monthlyTrendsChart" style="min-height: 350px;"></div>
                            <script>
                                document.addEventListener("DOMContentLoaded", () => {
                                    try {
                                        @if (data?.MonthlyTrends != null)
                                        {
                                            <text>
                                            const monthlyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data.MonthlyTrends));
                                            console.log("Monthly data:", monthlyData);
                                            
                                            if (typeof ApexCharts === 'undefined') {
                                                console.error("ApexCharts library not loaded");
                                                document.querySelector("#monthlyTrendsChart").innerHTML = '<div class="alert alert-warning">ApexCharts library not loaded</div>';
                                                return;
                                            }
                                            
                                            const chart = new ApexCharts(document.querySelector("#monthlyTrendsChart"), {
                                                series: [{
                                                    name: 'Meetings Held',
                                                    data: monthlyData.map(item => item.Count || 0),
                                                }],
                                                chart: {
                                                    height: 350,
                                                    type: 'area',
                                                    toolbar: { show: false },
                                                },
                                                markers: { size: 4 },
                                                colors: ['#4154f1'],
                                                fill: {
                                                    type: "gradient",
                                                    gradient: {
                                                        shadeIntensity: 1,
                                                        opacityFrom: 0.3,
                                                        opacityTo: 0.4,
                                                        stops: [0, 90, 100]
                                                    }
                                                },
                                                dataLabels: { enabled: false },
                                                stroke: { curve: 'smooth', width: 2 },
                                                xaxis: {
                                                    categories: monthlyData.map(item => item.Month || 'Unknown')
                                                },
                                                tooltip: {
                                                    x: { format: 'MMM yyyy' },
                                                }
                                            });
                                            
                                            chart.render();
                                            console.log("Chart rendered successfully");
                                            </text>
                                        }
                                        else
                                        {
                                            <text>
                                            document.querySelector("#monthlyTrendsChart").innerHTML = '<div class="alert alert-warning">No monthly trends data available</div>';
                                            </text>
                                        }
                                    } catch (error) {
                                        console.error("Chart error:", error);
                                        document.querySelector("#monthlyTrendsChart").innerHTML = '<div class="alert alert-danger">Error loading chart: ' + error.message + '</div>';
                                    }
                                });
                            </script>
                        </div>
                    </div>
                </div><!-- End Monthly Trends Chart -->

                <!-- Recent Meetings -->
                <div class="col-12">
                    <div class="card recent-sales overflow-auto">
                        <div class="card-body">
                            <h5 class="card-title">Recent Meetings <span>| Last 30 Days</span></h5>
                            
                            @if (data?.RecentMeetingsData != null && data.RecentMeetingsData.Length > 0)
                            {
                                <table class="table table-borderless datatable">
                                    <thead>
                                        <tr>
                                            <th scope="col">Meeting Details</th>
                                            <th scope="col">Type</th>
                                            <th scope="col">Department</th>
                                            <th scope="col">Venue</th>
                                            <th scope="col">Date & Time</th>
                                            <th scope="col">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var meeting in data.RecentMeetingsData)
                                        {
                                            <tr>
                                                <td>
                                                    <a asp-controller="Meeting" asp-action="MeetingAddEdit" asp-route-id="@meeting.MeetingID" class="fw-bold text-decoration-none">
                                                        @meeting.Description
                                                    </a>
                                                </td>
                                                <td><span class="badge bg-secondary">@meeting.MeetingTypeName</span></td>
                                                <td><span class="badge bg-primary">@meeting.DepartmentName</span></td>
                                                <td>
                                                    <i class="bi bi-geo-alt text-muted me-1"></i>
                                                    <span class="small">@meeting.VenueName</span>
                                                </td>
                                                <td>
                                                    <div class="d-flex flex-column">
                                                        <span class="fw-bold small">@meeting.MeetingDate.ToString("MMM dd, yyyy")</span>
                                                        <small class="text-muted">@meeting.MeetingDate.ToString("HH:mm")</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (meeting.IsCancelled)
                                                    {
                                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Cancelled</span>
                                                    }
                                                    else if (meeting.MeetingDate > DateTime.Now)
                                                    {
                                                        <span class="badge bg-info"><i class="bi bi-clock me-1"></i>Scheduled</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Completed</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="alert alert-info text-center">
                                    <i class="bi bi-calendar-x" style="font-size: 2rem;"></i>
                                    <p class="mt-2">No recent meetings found in the last 30 days</p>
                                </div>
                            }
                        </div>
                    </div>
                </div><!-- End Recent Meetings -->

                <!-- Quick Actions -->
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Quick Actions <span>| Management</span></h5>
                            <div class="row mb-3">
                                <div class="col-md-3 mb-2">
                                    <a asp-controller="Meeting" asp-action="MeetingAddEdit" class="btn btn-primary w-100">
                                        <i class="bi bi-plus-circle me-2"></i>New Meeting
                                    </a>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <a asp-controller="Department" asp-action="DepartmentAddEdit" class="btn btn-success w-100">
                                        <i class="bi bi-building me-2"></i>Add Department
                                    </a>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <a asp-controller="Staff" asp-action="StaffAddEdit" class="btn btn-info w-100">
                                        <i class="bi bi-person-plus me-2"></i>Add Staff
                                    </a>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <a asp-controller="MeetingVenue" asp-action="MeetingVenueAddEdit" class="btn btn-warning w-100">
                                        <i class="bi bi-geo-alt me-2"></i>Add Venue
                                    </a>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-borderless">
                                    <thead>
                                        <tr>
                                            <th scope="col">Module</th>
                                            <th scope="col">Description</th>
                                            <th scope="col">Total Records</th>
                                            <th scope="col">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><i class="bi bi-calendar-event text-primary me-2"></i><strong>Meetings</strong></td>
                                            <td>Manage all meeting records and minutes</td>
                                            <td class="fw-bold">@(data?.TotalMeetings ?? 0)</td>
                                            <td><a asp-controller="Meeting" asp-action="MeetingList" class="btn btn-sm btn-outline-primary">View All</a></td>
                                        </tr>
                                        <tr>
                                            <td><i class="bi bi-building text-success me-2"></i><strong>Departments</strong></td>
                                            <td>Organizational departments and divisions</td>
                                            <td class="fw-bold">@(data?.TotalDepartments ?? 0)</td>
                                            <td><a asp-controller="Department" asp-action="DepartmentList" class="btn btn-sm btn-outline-success">View All</a></td>
                                        </tr>
                                        <tr>
                                            <td><i class="bi bi-people text-info me-2"></i><strong>Staff</strong></td>
                                            <td>Employee records and meeting participants</td>
                                            <td class="fw-bold">@(data?.TotalStaff ?? 0)</td>
                                            <td><a asp-controller="Staff" asp-action="StaffList" class="btn btn-sm btn-outline-info">View All</a></td>
                                        </tr>
                                        <tr>
                                            <td><i class="bi bi-geo-alt text-warning me-2"></i><strong>Venues</strong></td>
                                            <td>Meeting locations and conference rooms</td>
                                            <td class="fw-bold">@(data?.TotalVenues ?? 0)</td>
                                            <td><a asp-controller="MeetingVenue" asp-action="MeetingVenueList" class="btn btn-sm btn-outline-warning">View All</a></td>
                                        </tr>
                                        <tr>
                                            <td><i class="bi bi-person-check text-secondary me-2"></i><strong>Members</strong></td>
                                            <td>Meeting participants and attendees</td>
                                            <td class="fw-bold">@(data?.ActiveMembers ?? 0)</td>
                                            <td><a asp-controller="MeetingMembers" asp-action="MeetingMemberList" class="btn btn-sm btn-outline-secondary">View All</a></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div><!-- End Quick Actions -->

            </div>
        </div><!-- End Left side columns -->

        <!-- Right side columns -->
        <div class="col-lg-4">

            <!-- Statistics Overview -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Statistics Overview <span>| Current</span></h5>
                    <div class="row text-center">
                        <div class="col-6 mb-3">
                            <div class="border rounded p-3">
                                <h4 class="text-primary mb-1">@(data?.AttendanceRate ?? 0)%</h4>
                                <small class="text-muted">Attendance Rate</small>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="border rounded p-3">
                                <h4 class="text-danger mb-1">@(data?.CancelledMeetings ?? 0)</h4>
                                <small class="text-muted">Cancelled</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-3">
                                <h4 class="text-success mb-1">@(data?.ActiveMembers ?? 0)</h4>
                                <small class="text-muted">Active Members</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-3">
                                <h4 class="text-info mb-1">@(data?.TotalVenues ?? 0)</h4>
                                <small class="text-muted">Venues</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- End Statistics Overview -->

            <!-- Department Distribution -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Meeting Distribution <span>| By Department</span></h5>
                    
                    <div id="departmentChart" style="min-height: 400px; margin-top: 30px;" class="echart"></div>
                    <script>
                        document.addEventListener("DOMContentLoaded", () => {
                            try {
                                @if (data?.DepartmentMeetings != null && data.DepartmentMeetings.Length > 0)
                                {
                                    <text>
                                    const departmentData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data.DepartmentMeetings));
                                    console.log("Department data:", departmentData);
                                    
                                    if (typeof echarts === 'undefined') {
                                        console.error("ECharts library not loaded");
                                        document.querySelector("#departmentChart").innerHTML = '<div class="alert alert-warning">ECharts library not loaded</div>';
                                        return;
                                    }
                                    
                                    const chart = echarts.init(document.querySelector("#departmentChart"));
                                    chart.setOption({
                                        tooltip: { trigger: 'item' },
                                        legend: { 
                                            top: '10%', 
                                            left: 'center',
                                            itemGap: 15
                                        },
                                        series: [{
                                            name: 'Meetings by Department',
                                            type: 'pie',
                                            radius: ['40%', '70%'],
                                            center: ['50%', '60%'],
                                            avoidLabelOverlap: false,
                                            label: { show: false, position: 'center' },
                                            emphasis: {
                                                label: { show: true, fontSize: '18', fontWeight: 'bold' }
                                            },
                                            labelLine: { show: false },
                                            data: departmentData.map(item => ({
                                                value: item.Count || 0,
                                                name: item.DepartmentName || 'Unknown'
                                            }))
                                        }]
                                    });
                                    console.log("Department chart rendered successfully");
                                    </text>
                                }
                                else
                                {
                                    <text>
                                    document.querySelector("#departmentChart").innerHTML = '<div class="alert alert-warning">No department data available</div>';
                                    </text>
                                }
                            } catch (error) {
                                console.error("Department chart error:", error);
                                document.querySelector("#departmentChart").innerHTML = '<div class="alert alert-danger">Error loading chart: ' + error.message + '</div>';
                            }
                        });
                    </script>
                </div>
            </div><!-- End Department Distribution -->

            <!-- Meeting Types -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Meeting Types <span>| Distribution</span></h5>
                    <div class="activity">
                        @if (data?.MeetingTypeDistribution != null && data.MeetingTypeDistribution.Length > 0)
                        {
                            @foreach (var type in data.MeetingTypeDistribution)
                            {
                                <div class="activity-item d-flex">
                                    <div class="activite-label">@type.Count</div>
                                    <i class='bi bi-circle-fill activity-badge text-primary align-self-start'></i>
                                    <div class="activity-content">
                                        <strong>@type.MeetingTypeName</strong>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-3">
                                <i class="bi bi-tags" style="font-size: 2rem;"></i>
                                <p class="mt-2">No meeting type data available</p>
                            </div>
                        }
                    </div>
                </div>
            </div><!-- End Meeting Types -->

            <!-- Upcoming Meetings -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Upcoming Meetings <span>| Next 5</span></h5>
                    <div class="news">
                        @if (data?.UpcomingMeetingsData != null && data.UpcomingMeetingsData.Length > 0)
                        {
                            @foreach (var meeting in data.UpcomingMeetingsData)
                            {
                                <div class="post-item clearfix mb-3">
                                    <div class="d-flex align-items-start">
                                        <div class="me-3">
                                            <i class="bi bi-calendar-event text-primary" style="font-size: 1.5rem;"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1">
                                                <a asp-controller="Meeting" asp-action="MeetingAddEdit" asp-route-id="@meeting.MeetingID" class="text-decoration-none">
                                                    @meeting.Description
                                                </a>
                                            </h6>
                                            <div class="d-flex flex-wrap gap-2 mb-2">
                                                <span class="badge bg-secondary small">@meeting.MeetingTypeName</span>
                                                <span class="badge bg-primary small">@meeting.DepartmentName</span>
                                                <span class="badge bg-info small"><i class="bi bi-geo-alt me-1"></i>@meeting.VenueName</span>
                                            </div>
                                            <small class="text-muted">
                                                <i class="bi bi-clock me-1"></i>@meeting.MeetingDate.ToString("MMM dd, yyyy 'at' HH:mm")
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-3">
                                <i class="bi bi-calendar-x" style="font-size: 2rem;"></i>
                                <p class="mt-2">No upcoming meetings scheduled</p>
                            </div>
                        }
                    </div>
                </div>
            </div><!-- End Upcoming Meetings -->

            <!-- Venue Utilization -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Venue Utilization <span>| Usage</span></h5>
                    @if (data?.VenueUtilization != null && data.VenueUtilization.Length > 0)
                    {
                        @foreach (var venue in data.VenueUtilization)
                        {
                            var percentage = (data?.TotalMeetings ?? 0) > 0 ? (double)venue.Count / (data?.TotalMeetings ?? 1) * 100 : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <span class="small">@venue.VenueName</span>
                                    <span class="small">@venue.Count meetings</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-primary" role="progressbar" 
                                         style="width: @percentage.ToString("F1")%" 
                                         aria-valuenow="@percentage.ToString("F1")" 
                                         aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-geo-alt" style="font-size: 2rem;"></i>
                            <p class="mt-2">No venue utilization data available</p>
                        </div>
                    }
                </div>
            </div><!-- End Venue Utilization -->

        </div><!-- End Right side columns -->

    </div>
</section>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @ViewBag.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}