@{
    ViewData["Title"] = "About MOM System";
}

<div class="pagetitle">
    <h1>About MOM System</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li class="breadcrumb-item active">About</li>
        </ol>
    </nav>
</div>

<section class="section">

    <!-- Intro Section -->
    <div class="row align-items-center mb-4">
        <div class="col-lg-6">
            <h3 class="fw-bold text-primary mb-3">What is MOM System?</h3>
            <p class="text-muted">
                <strong>MOM (Minutes of Meeting) System</strong> is a comprehensive
                digital solution designed to streamline meeting management, documentation,
                and follow-up processes within organizations.
            </p>
            <p class="text-muted">
                Our system helps organizations maintain transparency, accountability,
                and consistency across all meetings while reducing manual effort and
                ensuring proper documentation of decisions and action items.
            </p>
        </div>

        <div class="col-lg-6 text-center">
            <div class="card shadow-sm">
                <div class="card-body">
                    <i class="bi bi-calendar-event text-primary" style="font-size: 4rem;"></i>
                    <h5 class="mt-3">Efficient Meeting Management</h5>
                    <p class="text-muted small">Streamline your meeting processes from scheduling to follow-up</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <h4 class="fw-bold mb-3 text-center">Why Choose MOM System?</h4>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-people-fill text-primary" style="font-size: 3rem;"></i>
                    <h6 class="card-title fw-bold mt-3">Smart Collaboration</h6>
                    <p class="card-text text-muted small">
                        Centralize meetings, departments, members, and decisions
                        in one secure platform with role-based access control.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-graph-up text-success" style="font-size: 3rem;"></i>
                    <h6 class="card-title fw-bold mt-3">Improved Productivity</h6>
                    <p class="card-text text-muted small">
                        Reduce paperwork and automate meeting records with a
                        clean, user-friendly interface and automated workflows.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-shield-check text-info" style="font-size: 3rem;"></i>
                    <h6 class="card-title fw-bold mt-3">Secure & Scalable</h6>
                    <p class="card-text text-muted small">
                        Built using ASP.NET Core with robust security features
                        and scalable architecture for growing organizations.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Key Features -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <h4 class="fw-bold mb-3 text-center">Key Features</h4>
        </div>
        
        <div class="col-lg-6">
            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    <strong>Meeting Management:</strong> Schedule, track, and manage all meetings
                </li>
                <li class="list-group-item">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    <strong>Department Organization:</strong> Organize meetings by departments
                </li>
                <li class="list-group-item">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    <strong>Staff Management:</strong> Maintain staff records and roles
                </li>
                <li class="list-group-item">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    <strong>Venue Booking:</strong> Manage meeting venues and resources
                </li>
            </ul>
        </div>
        
        <div class="col-lg-6">
            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    <strong>Minutes Documentation:</strong> Digital meeting minutes with attachments
                </li>
                <li class="list-group-item">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    <strong>Action Item Tracking:</strong> Follow up on decisions and tasks
                </li>
                <li class="list-group-item">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    <strong>Reporting & Analytics:</strong> Generate insights and reports
                </li>
                <li class="list-group-item">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    <strong>Search & Archive:</strong> Easy search and historical records
                </li>
            </ul>
        </div>
    </div>

    <!-- Technology Section -->
    <div class="row align-items-center">
        <div class="col-lg-6 text-center mb-3 mb-lg-0">
            <div class="card shadow-sm">
                <div class="card-body">
                    <i class="bi bi-code-slash text-primary" style="font-size: 4rem;"></i>
                    <h5 class="mt-3">Modern Technology Stack</h5>
                    <p class="text-muted small">Built with cutting-edge technologies for reliability and performance</p>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <h4 class="fw-bold text-primary mb-3">Technology Behind MOM System</h4>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    <strong>Backend:</strong> ASP.NET Core MVC (.NET 10)
                </li>
                <li class="list-group-item">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    <strong>Frontend:</strong> Bootstrap 5 & NiceAdmin UI Template
                </li>
                <li class="list-group-item">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    <strong>Database:</strong> SQL Server with Entity Framework
                </li>
                <li class="list-group-item">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    <strong>Architecture:</strong> MVC Pattern with Service Layer
                </li>
                <li class="list-group-item">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    <strong>Security:</strong> Authentication & Authorization
                </li>
            </ul>
        </div>
    </div>

</section>
