@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="pagetitle">
    <h1>Privacy Policy</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li class="breadcrumb-item active">Privacy Policy</li>
        </ol>
    </nav>
</div>

<section class="section">

    <!-- Intro -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="fw-bold text-primary mb-2">Your Privacy Matters</h4>
                    <p class="text-muted mb-0">
                        At <strong>MOM System</strong>, we are committed to protecting your
                        privacy and ensuring the security of your personal and organizational data.
                        This Privacy Policy explains how we collect, use, and safeguard information
                        within our Minutes of Meeting management system.
                    </p>
                    <small class="text-muted">Last updated: February 3, 2026</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Policy Content -->
    <div class="row">
        <div class="col-lg-12">

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-bold"><i class="bi bi-info-circle text-primary me-2"></i>1. Information We Collect</h6>
                    <p class="text-muted small mb-2">
                        We collect information necessary for effective meeting management:
                    </p>
                    <ul class="text-muted small mb-0">
                        <li>User account information (name, email, department)</li>
                        <li>Meeting data (titles, dates, venues, participants)</li>
                        <li>Meeting minutes and documentation</li>
                        <li>Department and staff organizational data</li>
                        <li>System usage logs for security and performance</li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-bold"><i class="bi bi-gear text-success me-2"></i>2. How We Use Your Information</h6>
                    <ul class="text-muted small mb-0">
                        <li>To manage meetings, participants, and organizational structure</li>
                        <li>To maintain meeting minutes and historical records</li>
                        <li>To provide dashboard analytics and reporting</li>
                        <li>To ensure system security and user authentication</li>
                        <li>To improve system performance and user experience</li>
                        <li>To provide technical support when required</li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-bold"><i class="bi bi-shield-check text-info me-2"></i>3. Data Security</h6>
                    <p class="text-muted small mb-2">
                        MOM System employs industry-standard security measures:
                    </p>
                    <ul class="text-muted small mb-0">
                        <li>Encrypted data transmission (HTTPS/SSL)</li>
                        <li>Secure user authentication and session management</li>
                        <li>Role-based access controls</li>
                        <li>Regular security updates and monitoring</li>
                        <li>Secure database storage with backup procedures</li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-bold"><i class="bi bi-people text-warning me-2"></i>4. Data Sharing and Access</h6>
                    <p class="text-muted small mb-0">
                        We <strong>do not</strong> sell, trade, or rent user data to third parties.
                        Meeting data is only accessible to authorized users within your organization
                        based on their assigned roles and permissions. Information may only be shared
                        when required by law or with explicit user consent.
                    </p>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-bold"><i class="bi bi-cookie text-secondary me-2"></i>5. Cookies & Session Management</h6>
                    <p class="text-muted small mb-0">
                        MOM System uses essential cookies for authentication, session management,
                        and system functionality. We do not use third-party tracking cookies or
                        advertising cookies. Session cookies are automatically deleted when you
                        log out or close your browser.
                    </p>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-bold"><i class="bi bi-person-check text-primary me-2"></i>6. User Rights and Responsibilities</h6>
                    <div class="row">
                        <div class="col-md-6">
                            <p class="text-muted small mb-2"><strong>Your Rights:</strong></p>
                            <ul class="text-muted small mb-0">
                                <li>Access your personal data</li>
                                <li>Request data corrections</li>
                                <li>Export your meeting data</li>
                                <li>Request account deletion</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-2"><strong>Your Responsibilities:</strong></p>
                            <ul class="text-muted small mb-0">
                                <li>Keep login credentials secure</li>
                                <li>Use the system appropriately</li>
                                <li>Report security concerns</li>
                                <li>Respect other users' privacy</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-bold"><i class="bi bi-archive text-info me-2"></i>7. Data Retention</h6>
                    <p class="text-muted small mb-0">
                        Meeting data and minutes are retained according to your organization's
                        record-keeping policies. User account data is maintained while the account
                        is active. Deleted data is permanently removed from our systems within
                        30 days, except where retention is required by law.
                    </p>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-bold"><i class="bi bi-arrow-clockwise text-warning me-2"></i>8. Policy Updates</h6>
                    <p class="text-muted small mb-0">
                        This Privacy Policy may be updated periodically to reflect changes in
                        our practices or legal requirements. We will notify users of significant
                        changes through the system or email. Continued use of MOM System after
                        updates indicates acceptance of the revised policy.
                    </p>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold"><i class="bi bi-envelope text-primary me-2"></i>9. Contact Us</h6>
                    <p class="text-muted small mb-2">
                        If you have any questions regarding this Privacy Policy or your data:
                    </p>
                    <ul class="text-muted small mb-0">
                        <li><strong>Email:</strong> privacy@momsystem.com</li>
                        <li><strong>Support:</strong> support@momsystem.com</li>
                        <li><strong>Phone:</strong> +91 98765 43210</li>
                    </ul>
                </div>
            </div>

        </div>
    </div>

</section>
