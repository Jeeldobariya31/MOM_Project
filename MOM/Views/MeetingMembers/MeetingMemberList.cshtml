@using System.Data
@model System.Data.DataTable

@{
    ViewData["Title"] = "Meeting Members";
    var searchTerm = ViewBag.Search as string ?? "";
    var meetingFilter = ViewBag.MeetingFilter as int? ?? 0;
    var departmentFilter = ViewBag.DepartmentFilter as int? ?? 0;
    var attendanceFilter = ViewBag.AttendanceFilter as string ?? "";
    var totalRecords = ViewBag.TotalRecords as int? ?? 0;
    var filteredRecords = Model.Rows.Count;

    string GetValue(System.Data.DataRow row, string col)
    {
        return Model.Columns.Contains(col) ? row[col]?.ToString() ?? "" : "";
    }

    bool GetBool(System.Data.DataRow row, string col)
    {
        return Model.Columns.Contains(col) && row[col] != DBNull.Value && Convert.ToBoolean(row[col]);
    }

    DateTime GetDate(System.Data.DataRow row, string col)
    {
        return Model.Columns.Contains(col) && row[col] != DBNull.Value
            ? Convert.ToDateTime(row[col])
            : DateTime.MinValue;
    }
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-people me-2"></i>Meeting Members</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item">Meetings</li>
                    <li class="breadcrumb-item active">Meeting Members</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="MeetingMemberAddEdit" class="btn btn-light">
                <i class="bi bi-person-plus me-1"></i>Assign Member
            </a>
            <button type="button" class="btn btn-primary" onclick="showBulkAssignModal()">
                <i class="bi bi-people-fill me-1"></i>Bulk Assign
            </button>
            <button type="button" class="btn btn-success" onclick="showBulkAttendanceModal()">
                <i class="bi bi-check2-square me-1"></i>Bulk Attendance
            </button>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-hover">
                <div class="card-body">
                    <!-- Header with Stats -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h5 class="card-title mb-1">
                                <i class="bi bi-people text-primary me-2"></i>
                                Meeting Member Management
                            </h5>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Showing @filteredRecords of @totalRecords member assignments
                            </p>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="modernUI.exportTable('#memberTable', 'meeting-members', 'csv')">
                                <i class="bi bi-file-earmark-excel me-1"></i>
                                Export
                            </button>
                            <a asp-action="MeetingMemberAddEdit" class="btn btn-outline-primary">
                                <i class="bi bi-person-plus me-1"></i>Assign Member
                            </a>
                            <button type="button" class="btn btn-primary" onclick="showBulkAssignModal()">
                                <i class="bi bi-people-fill me-1"></i>Bulk Assign
                            </button>
                            <button type="button" class="btn btn-success" onclick="showBulkAttendanceModal()">
                                <i class="bi bi-check2-square me-1"></i>Bulk Attendance
                            </button>
                        </div>
                    </div>

                    <!-- Search and Filter Section -->
                    <div class="filter-section">
                        <form method="get" class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Search Members</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text" 
                                           name="search" 
                                           value="@searchTerm" 
                                           class="form-control" 
                                           placeholder="Search by staff name, meeting, or department..." />
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-search me-1"></i>Search
                                    </button>
                                </div>
                            </div>
                            
                            <div class="col-md-3">
                                <label class="form-label">Meeting Filter</label>
                                <select name="meetingFilter" class="form-select">
                                    <option value="">All Meetings</option>
                                    @foreach (System.Data.DataRow meeting in ViewBag.Meetings.Rows)
                                    {
                                        <option value="@meeting["MeetingID"]" 
                                                selected="@(meetingFilter == Convert.ToInt32(meeting["MeetingID"]))">
                                            @meeting["MeetingDescription"] - @Convert.ToDateTime(meeting["MeetingDate"]).ToString("MMM dd, yyyy")
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Department</label>
                                <select name="departmentFilter" class="form-select">
                                    <option value="">All Departments</option>
                                    @foreach (System.Data.DataRow dept in ViewBag.Departments.Rows)
                                    {
                                        <option value="@dept["DepartmentID"]" 
                                                selected="@(departmentFilter == Convert.ToInt32(dept["DepartmentID"]))">
                                            @dept["DepartmentName"]
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Attendance</label>
                                <select name="attendanceFilter" class="form-select">
                                    <option value="">All</option>
                                    <option value="Present" selected="@(attendanceFilter == "Present")">Present</option>
                                    <option value="Absent" selected="@(attendanceFilter == "Absent")">Absent</option>
                                </select>
                            </div>
                            
                            <div class="col-md-1 d-flex align-items-end">
                                @if (!string.IsNullOrEmpty(searchTerm) || meetingFilter > 0 || departmentFilter > 0 || !string.IsNullOrEmpty(attendanceFilter))
                                {
                                    <a href="@Url.Action("MeetingMemberList")" class="btn btn-outline-secondary w-100">
                                        <i class="bi bi-x-lg me-1"></i>Clear
                                    </a>
                                }
                            </div>
                        </form>
                    </div>

                    <!-- Data Table -->
                    <div class="table-container">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle" id="memberTable">
                                <thead>
                                    <tr>
                                        <th>Staff Member</th>
                                        <th>Meeting Details</th>
                                        <th>Department</th>
                                        <th>Meeting Date</th>
                                        <th>Attendance</th>
                                        <th>Remarks</th>
                                        <th class="text-center" style="width: 280px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Rows.Count > 0)
                                    {
                                        @foreach (System.Data.DataRow row in Model.Rows)
                                        {
                                            bool isPresent = GetBool(row, "IsPresent");
                                            DateTime meetingDate = GetDate(row, "MeetingDate");
                                            string id = GetValue(row, "MeetingMemberID");
                                            string meetingDesc = GetValue(row, "MeetingDescription");
                                            string staffName = GetValue(row, "StaffName");
                                            string deptName = GetValue(row, "DepartmentName");
                                            string remarks = GetValue(row, "Remarks");
                                            string meetingType = GetValue(row, "MeetingTypeName");
                                            string venue = GetValue(row, "VenueName");

                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar bg-primary me-3">
                                                            <i class="bi bi-person"></i>
                                                        </div>
                                                        <div>
                                                            <h6 class="mb-0 fw-semibold">@staffName</h6>
                                                            <small class="text-muted">ID: @GetValue(row, "StaffID")</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div>
                                                        <h6 class="mb-1 fw-medium">@meetingDesc</h6>
                                                        <div class="d-flex gap-1">
                                                            <span class="badge bg-info">@meetingType</span>
                                                            @if (!string.IsNullOrEmpty(venue))
                                                            {
                                                                <span class="badge bg-secondary">@venue</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-info">@deptName</span>
                                                </td>
                                                <td>
                                                    <div>
                                                        <span class="fw-medium">
                                                            @(meetingDate == DateTime.MinValue ? "" : meetingDate.ToString("dd MMM yyyy"))
                                                        </span>
                                                        <br>
                                                        <small class="text-muted">
                                                            @(meetingDate == DateTime.MinValue ? "" : meetingDate.ToString("hh:mm tt"))
                                                        </small>
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (isPresent)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="bi bi-check-circle me-1"></i>Present
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">
                                                            <i class="bi bi-x-circle me-1"></i>Absent
                                                        </span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(remarks))
                                                    {
                                                        <div class="text-truncate" style="max-width: 150px;" title="@remarks">
                                                            @remarks
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No remarks</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group" role="group">
                                                        <!-- Attendance Toggle Button -->
                                                        <button type="button" 
                                                                class="btn @(isPresent ? "btn-success" : "btn-outline-danger") btn-sm attendance-toggle" 
                                                                onclick="toggleAttendance(@id, @(isPresent ? "true" : "false"))"
                                                                title="@(isPresent ? "Mark as Absent" : "Mark as Present")"
                                                                data-member-id="@id">
                                                            <i class="bi bi-@(isPresent ? "check-circle-fill" : "x-circle")"></i>
                                                            <span class="d-none d-md-inline ms-1">@(isPresent ? "Present" : "Absent")</span>
                                                        </button>
                                                        
                                                        <button type="button" 
                                                                class="btn btn-outline-info btn-sm" 
                                                                onclick="viewMeetingMember(@id)"
                                                                title="View Details">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <a asp-action="MeetingMemberAddEdit" asp-route-id="@id"
                                                           class="btn btn-outline-primary btn-sm" 
                                                           title="Edit Member">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                        <button type="button" 
                                                                class="btn btn-outline-danger btn-sm" 
                                                                onclick="deleteMeetingMember(@id)" 
                                                                title="Remove Member">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7">
                                                <div class="empty-state">
                                                    <i class="bi bi-people"></i>
                                                    @if (!string.IsNullOrEmpty(searchTerm) || meetingFilter > 0 || departmentFilter > 0 || !string.IsNullOrEmpty(attendanceFilter))
                                                    {
                                                        <h3>No meeting members found</h3>
                                                        <p>No meeting members match your search criteria</p>
                                                        <a href="@Url.Action("MeetingMemberList")" class="btn btn-outline-primary">
                                                            <i class="bi bi-arrow-left me-1"></i>Clear Filters
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <h3>No meeting members yet</h3>
                                                        <p>Get started by assigning your first meeting member</p>
                                                        <a asp-action="MeetingMemberAddEdit" class="btn btn-primary">
                                                            <i class="bi bi-person-plus me-1"></i>Assign First Member
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Pagination -->
                    @if (ViewBag.TotalPages > 1)
                    {
                        <nav aria-label="Meeting members pagination">
                            <ul class="pagination justify-content-center">
                                @if (ViewBag.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("MeetingMemberList", new { 
                                            page = ViewBag.CurrentPage - 1, 
                                            search = ViewBag.Search,
                                            meetingFilter = ViewBag.MeetingFilter,
                                            departmentFilter = ViewBag.DepartmentFilter,
                                            attendanceFilter = ViewBag.AttendanceFilter,
                                            pageSize = ViewBag.PageSize
                                        })">Previous</a>
                                    </li>
                                }

                                @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("MeetingMemberList", new { 
                                            page = i, 
                                            search = ViewBag.Search,
                                            meetingFilter = ViewBag.MeetingFilter,
                                            departmentFilter = ViewBag.DepartmentFilter,
                                            attendanceFilter = ViewBag.AttendanceFilter,
                                            pageSize = ViewBag.PageSize
                                        })">@i</a>
                                    </li>
                                }

                                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("MeetingMemberList", new { 
                                            page = ViewBag.CurrentPage + 1, 
                                            search = ViewBag.Search,
                                            meetingFilter = ViewBag.MeetingFilter,
                                            departmentFilter = ViewBag.DepartmentFilter,
                                            attendanceFilter = ViewBag.AttendanceFilter,
                                            pageSize = ViewBag.PageSize
                                        })">Next</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }

                </div>
            </div>
        </div>
    </div>
</section>



@section Scripts {
    @Html.AntiForgeryToken()
    <style>
        .spin {
            animation: spin 1s linear infinite;
        }
        
        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        
        .attendance-toggle {
            min-width: 90px;
        }
        
        @@media (max-width: 768px) {
            .attendance-toggle {
                min-width: 40px;
            }
        }
    </style>
    <script>
        // Toggle attendance status
        function toggleAttendance(memberId, currentStatus) {
            const button = document.querySelector(`button[data-member-id="${memberId}"]`);
            if (!button) return;
            
            // Store original button content
            const originalContent = button.innerHTML;
            const originalClass = button.className;
            
            // Show loading state
            button.disabled = true;
            button.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> <span class="d-none d-md-inline ms-1">Updating...</span>';
            button.className = 'btn btn-outline-secondary btn-sm attendance-toggle';
            
            fetch('/MeetingMembers/ToggleAttendance', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: `id=${memberId}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update button appearance based on new status
                    const isPresent = data.isPresent;
                    const newClass = isPresent ? 'btn btn-success btn-sm attendance-toggle' : 'btn btn-outline-danger btn-sm attendance-toggle';
                    const newIcon = isPresent ? 'check-circle-fill' : 'x-circle';
                    const newText = isPresent ? 'Present' : 'Absent';
                    const newTitle = isPresent ? 'Mark as Absent' : 'Mark as Present';
                    
                    button.className = newClass;
                    button.innerHTML = `<i class="bi bi-${newIcon}"></i> <span class="d-none d-md-inline ms-1">${newText}</span>`;
                    button.title = newTitle;
                    button.setAttribute('onclick', `toggleAttendance(${memberId}, ${isPresent})`);
                    
                    // Update the attendance badge in the table
                    const row = button.closest('tr');
                    const attendanceBadge = row.querySelector('td:nth-child(5) .badge');
                    if (attendanceBadge) {
                        if (isPresent) {
                            attendanceBadge.className = 'badge bg-success';
                            attendanceBadge.innerHTML = '<i class="bi bi-check-circle me-1"></i>Present';
                        } else {
                            attendanceBadge.className = 'badge bg-danger';
                            attendanceBadge.innerHTML = '<i class="bi bi-x-circle me-1"></i>Absent';
                        }
                    }
                    
                    // Show success toast
                    modernUI.showToast(data.message, 'success');
                } else {
                    // Restore original button state on error
                    button.innerHTML = originalContent;
                    button.className = originalClass;
                    modernUI.showToast(data.message || 'Failed to update attendance', 'error');
                }
            })
            .catch(error => {
                // Restore original button state on error
                button.innerHTML = originalContent;
                button.className = originalClass;
                modernUI.showToast('Network error occurred while updating attendance', 'error');
            })
            .finally(() => {
                button.disabled = false;
            });
        }

        // Bulk attendance update modal
        function showBulkAttendanceModal() {
            loadBulkAttendanceData();
        }

        function loadBulkAttendanceData() {
            Promise.all([
                fetch('/MeetingMembers/GetMeetingsForBulkAssign').then(r => {
                    if (!r.ok) throw new Error(`HTTP ${r.status}: ${r.statusText}`);
                    return r.json();
                })
            ])
            .then(([meetings]) => {
                if (!meetings || !Array.isArray(meetings) || meetings.length === 0) {
                    throw new Error('No meetings available');
                }
                
                const meetingOptions = meetings.map(m => {
                    const meetingDate = (m.meetingDate || m.MeetingDate) ? new Date(m.meetingDate || m.MeetingDate).toLocaleDateString() : 'Invalid Date';
                    const description = (m.meetingDescription || m.MeetingDescription) || 'No Description';
                    const meetingId = m.meetingID || m.MeetingID || '';
                    return `<option value="${meetingId}">${description} - ${meetingDate}</option>`;
                }).join('');

                showBulkAttendanceModalWithData(meetingOptions);
            })
            .catch(error => {
                modernUI.showToast(`Error loading data: ${error.message}`, 'error');
            });
        }

        function showBulkAttendanceModalWithData(meetingOptions) {
            modernUI.showModal({
                title: 'Bulk Update Attendance',
                content: `
                    <form id="bulkAttendanceForm">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Select Meeting <span class="text-danger">*</span></label>
                                <select name="meetingId" class="form-select" required onchange="loadMeetingMembers(this.value)">
                                    <option value="">-- Select Meeting --</option>
                                    ${meetingOptions}
                                </select>
                            </div>

                            <div class="col-12" id="meetingMembersList" style="display: none;">
                                <label class="form-label">Meeting Members</label>
                                <div id="membersList" class="border rounded p-3" style="max-height: 400px; overflow-y: auto;">
                                    <p class="text-muted">Please select a meeting first.</p>
                                </div>
                            </div>
                        </div>
                    </form>
                `,
                size: 'lg',
                buttons: [
                    {
                        text: 'Update Attendance',
                        class: 'btn-success',
                        onclick: 'submitBulkAttendance()'
                    },
                    {
                        text: 'Cancel',
                        class: 'btn-secondary'
                    }
                ]
            });
        }

        function loadMeetingMembers(meetingId) {
            if (!meetingId) {
                document.getElementById('meetingMembersList').style.display = 'none';
                return;
            }

            // Show loading state
            document.getElementById('membersList').innerHTML = '<p class="text-muted"><i class="bi bi-arrow-repeat spin me-2"></i>Loading members...</p>';
            document.getElementById('meetingMembersList').style.display = 'block';

            // Get meeting members for the selected meeting via AJAX
            fetch(`/MeetingMembers/GetMeetingMembersForAttendance?meetingId=${meetingId}`)
                .then(response => response.json())
                .then(data => {
                    if (!data || data.length === 0) {
                        document.getElementById('membersList').innerHTML = '<p class="text-muted">No members assigned to this meeting.</p>';
                        return;
                    }

                    const membersHtml = `
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <button type="button" class="btn btn-sm btn-success" onclick="markAllPresent()">Mark All Present</button>
                                <button type="button" class="btn btn-sm btn-danger ms-2" onclick="markAllAbsent()">Mark All Absent</button>
                            </div>
                        </div>
                        <div class="row">
                            ${data.map(member => `
                                <div class="col-md-6 mb-2">
                                    <div class="card border-0 bg-light">
                                        <div class="card-body p-2">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h6 class="mb-0">${member.staffName || 'Unknown Staff'}</h6>
                                                    <small class="text-muted">${member.departmentName || 'Unknown Dept'}</small>
                                                </div>
                                                <div class="btn-group" role="group">
                                                    <input type="radio" class="btn-check" name="attendance_${member.meetingMemberID}" 
                                                           id="present_${member.meetingMemberID}" value="present" 
                                                           ${member.isPresent ? 'checked' : ''}>
                                                    <label class="btn btn-outline-success btn-sm" for="present_${member.meetingMemberID}">
                                                        <i class="bi bi-check-circle"></i> Present
                                                    </label>
                                                    
                                                    <input type="radio" class="btn-check" name="attendance_${member.meetingMemberID}" 
                                                           id="absent_${member.meetingMemberID}" value="absent" 
                                                           ${!member.isPresent ? 'checked' : ''}>
                                                    <label class="btn btn-outline-danger btn-sm" for="absent_${member.meetingMemberID}">
                                                        <i class="bi bi-x-circle"></i> Absent
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    `;

                    document.getElementById('membersList').innerHTML = membersHtml;
                })
                .catch(error => {
                    document.getElementById('membersList').innerHTML = '<p class="text-danger">Error loading members. Please try again.</p>';
                    console.error('Error loading meeting members:', error);
                });
        }

        function markAllPresent() {
            document.querySelectorAll('input[type="radio"][value="present"]').forEach(radio => {
                radio.checked = true;
            });
        }

        function markAllAbsent() {
            document.querySelectorAll('input[type="radio"][value="absent"]').forEach(radio => {
                radio.checked = true;
            });
        }

        function submitBulkAttendance() {
            const form = document.getElementById('bulkAttendanceForm');
            const meetingId = form.meetingId.value;

            if (!meetingId) {
                modernUI.showToast('Please select a meeting', 'error');
                return;
            }

            // Collect attendance data
            const presentIds = [];
            const absentIds = [];

            document.querySelectorAll('input[type="radio"]:checked').forEach(radio => {
                const memberId = radio.name.split('_')[1];
                if (radio.value === 'present') {
                    presentIds.push(parseInt(memberId));
                } else {
                    absentIds.push(parseInt(memberId));
                }
            });

            if (presentIds.length === 0 && absentIds.length === 0) {
                modernUI.showToast('No attendance changes detected', 'warning');
                return;
            }

            // Disable the submit button
            const submitBtn = document.querySelector('.btn-success');
            const originalText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Updating...';

            // Submit bulk attendance update
            const formData = new FormData();
            formData.append('meetingId', meetingId);
            presentIds.forEach(id => formData.append('presentIds', id));
            absentIds.forEach(id => formData.append('absentIds', id));

            fetch('/MeetingMembers/BulkUpdateAttendance', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    modernUI.closeModal();
                    modernUI.showToast(data.message, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    modernUI.showToast(data.message || 'Error updating attendance', 'error');
                }
            })
            .catch(error => {
                modernUI.showToast('Network error occurred while updating attendance', 'error');
            })
            .finally(() => {
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
            });
        }

        // Bulk assign members to meeting modal
        function showBulkAssignModal() {
            loadDataViaAjax();
        }

        function loadMeetingDetails(meetingId) {
            if (!meetingId) {
                document.getElementById('meetingDetails').style.display = 'none';
                document.getElementById('staffList').innerHTML = '<p class="text-muted">Please select a meeting first.</p>';
                return;
            }

            // Load meeting details via AJAX
            fetch(`/MeetingMembers/GetMeetingDetails?meetingId=${meetingId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data) {
                        const meetingDate = new Date(data.meetingDate || data.MeetingDate).toLocaleDateString('en-GB', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                        });
                        
                        const description = (data.meetingDescription || data.MeetingDescription) || 'N/A';
                        const typeName = (data.meetingTypeName || data.MeetingTypeName) || 'N/A';
                        const venueName = (data.venueName || data.VenueName) || 'N/A';
                        const deptName = (data.departmentName || data.DepartmentName) || 'N/A';
                        const isCancelled = data.isCancelled || data.IsCancelled || false;
                        
                        document.getElementById('meetingInfo').innerHTML = `
                            <strong>Meeting:</strong> ${description}<br>
                            <strong>Date:</strong> ${meetingDate}<br>
                            <strong>Type:</strong> ${typeName}<br>
                            <strong>Venue:</strong> ${venueName}<br>
                            <strong>Department:</strong> ${deptName}
                            ${isCancelled ? '<br><span class="text-danger"><strong>Status:</strong> Cancelled</span>' : ''}
                        `;
                        document.getElementById('meetingDetails').style.display = 'block';
                        
                        if (isCancelled) {
                            document.getElementById('staffList').innerHTML = '<p class="text-warning">Cannot assign members to a cancelled meeting.</p>';
                            return;
                        }
                    } else {
                        modernUI.showToast('Meeting not found', 'error');
                        return;
                    }
                })
                .catch(error => {
                    modernUI.showToast('Error loading meeting details', 'error');
                });

            // Load staff list
            loadStaffList();
        }

        function loadStaffList() {
            if (!window.staffData || window.staffData.length === 0) {
                document.getElementById('staffList').innerHTML = '<p class="text-muted">No staff members available.</p>';
                return;
            }

            const meetingId = document.querySelector('select[name="meetingId"]').value;
            
            // Get already assigned members for this meeting
            let assignedMembers = [];
            if (meetingId) {
                fetch(`/MeetingMembers/GetAssignedMembers?meetingId=${meetingId}`)
                    .then(response => response.json())
                    .then(data => {
                        assignedMembers = data || [];
                        renderStaffList(assignedMembers);
                    })
                    .catch(error => {
                        renderStaffList([]);
                    });
            } else {
                renderStaffList([]);
            }
        }

        function renderStaffList(assignedMembers) {
            const staffListHtml = window.staffData.map(staff => {
                const staffId = staff.staffID || staff.StaffID || '';
                const staffName = (staff.staffName || staff.StaffName) || 'Unknown';
                const deptId = staff.departmentID || staff.DepartmentID || '';
                const deptName = (staff.departmentName || staff.DepartmentName) || 'Unknown Dept';
                
                const isAssigned = assignedMembers.includes(parseInt(staffId));
                const disabledAttr = isAssigned ? 'disabled' : '';
                const assignedText = isAssigned ? ' <small class="text-success">(Already assigned)</small>' : '';
                
                return `
                    <div class="form-check">
                        <input class="form-check-input staff-checkbox" type="checkbox" name="staffIds" value="${staffId}" 
                               id="staff_${staffId}" data-dept="${deptId}" ${disabledAttr}>
                        <label class="form-check-label" for="staff_${staffId}">
                            ${staffName} <small class="text-muted">(${deptName})</small>${assignedText}
                        </label>
                    </div>
                `;
            }).join('');

            document.getElementById('staffList').innerHTML = staffListHtml;
        }

        function filterStaff() {
            const selectedDept = document.getElementById('deptFilter').value;
            const checkboxes = document.querySelectorAll('.staff-checkbox');
            
            checkboxes.forEach(checkbox => {
                const parentDiv = checkbox.closest('.form-check');
                if (!selectedDept || checkbox.dataset.dept === selectedDept) {
                    parentDiv.style.display = 'block';
                } else {
                    parentDiv.style.display = 'none';
                    if (!checkbox.disabled) {
                        checkbox.checked = false;
                    }
                }
            });
        }

        function selectAllStaff(selectAll) {
            const visibleCheckboxes = document.querySelectorAll('.staff-checkbox');
            visibleCheckboxes.forEach(checkbox => {
                if (checkbox.closest('.form-check').style.display !== 'none' && !checkbox.disabled) {
                    checkbox.checked = selectAll;
                }
            });
        }

        function submitBulkAssign() {
            const form = document.getElementById('bulkAssignForm');
            const meetingId = form.meetingId.value;
            const selectedStaff = Array.from(form.querySelectorAll('input[name="staffIds"]:checked:not(:disabled)')).map(cb => cb.value);

            if (!meetingId) {
                modernUI.showToast('Please select a meeting', 'error');
                return;
            }

            if (selectedStaff.length === 0) {
                modernUI.showToast('Please select at least one staff member', 'error');
                return;
            }

            // Disable the submit button to prevent double submission
            const submitBtn = document.querySelector('.btn-primary');
            const originalText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Assigning...';

            // Submit bulk assignment
            const formData = new FormData();
            formData.append('meetingId', meetingId);
            selectedStaff.forEach(staffId => formData.append('staffIds', staffId));

            fetch('/MeetingMembers/BulkAssignMembers', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    modernUI.closeModal();
                    modernUI.showToast(`Successfully assigned ${selectedStaff.length} member(s) to the meeting`, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    modernUI.showToast(data.message || 'Error assigning members', 'error');
                }
            })
            .catch(error => {
                modernUI.showToast('Network error occurred while assigning members', 'error');
            })
            .finally(() => {
                // Re-enable the submit button
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
            });
        }

        // Load data via AJAX for bulk assign modal
        function loadDataViaAjax() {
            Promise.all([
                fetch('/MeetingMembers/GetMeetingsForBulkAssign').then(r => {
                    if (!r.ok) throw new Error(`HTTP ${r.status}: ${r.statusText}`);
                    return r.json();
                }),
                fetch('/MeetingMembers/GetDepartmentsForBulkAssign').then(r => {
                    if (!r.ok) throw new Error(`HTTP ${r.status}: ${r.statusText}`);
                    return r.json();
                }),
                fetch('/MeetingMembers/GetStaffForBulkAssign').then(r => {
                    if (!r.ok) throw new Error(`HTTP ${r.status}: ${r.statusText}`);
                    return r.json();
                })
            ])
            .then(([meetings, departments, staff]) => {
                if (!meetings || !Array.isArray(meetings) || meetings.length === 0) {
                    throw new Error('No meetings available');
                }
                
                if (!departments || !Array.isArray(departments) || departments.length === 0) {
                    throw new Error('No departments available');
                }
                
                if (!staff || !Array.isArray(staff) || staff.length === 0) {
                    throw new Error('No staff members available');
                }
                
                const meetingOptions = meetings.map(m => {
                    const meetingDate = (m.meetingDate || m.MeetingDate) ? new Date(m.meetingDate || m.MeetingDate).toLocaleDateString() : 'Invalid Date';
                    const description = (m.meetingDescription || m.MeetingDescription) || 'No Description';
                    const meetingId = m.meetingID || m.MeetingID || '';
                    return `<option value="${meetingId}">${description} - ${meetingDate}</option>`;
                }).join('');

                const deptOptions = departments.map(d => {
                    const deptId = d.departmentID || d.DepartmentID || '';
                    const deptName = (d.departmentName || d.DepartmentName) || 'Unknown Department';
                    return `<option value="${deptId}">${deptName}</option>`;
                }).join('');

                // Store staff data globally
                window.staffData = staff;

                showBulkAssignModalWithData(meetingOptions, deptOptions);
            })
            .catch(error => {
                modernUI.showToast(`Error loading data: ${error.message}`, 'error');
            });
        }

        function showBulkAssignModalWithData(meetingOptions, deptOptions) {
            modernUI.showModal({
                title: 'Bulk Assign Members to Meeting',
                content: `
                    <form id="bulkAssignForm">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Select Meeting <span class="text-danger">*</span></label>
                                <select name="meetingId" class="form-select" required onchange="loadMeetingDetails(this.value)">
                                    <option value="">-- Select Meeting --</option>
                                    ${meetingOptions}
                                </select>
                            </div>

                            <div class="col-12" id="meetingDetails" style="display: none;">
                                <div class="alert alert-info" id="meetingInfo"></div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Filter by Department</label>
                                <select id="deptFilter" class="form-select" onchange="filterStaff()">
                                    <option value="">All Departments</option>
                                    ${deptOptions}
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Select All/None</label>
                                <div>
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="selectAllStaff(true)">Select All</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAllStaff(false)">Select None</button>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Select Staff Members <span class="text-danger">*</span></label>
                                <div id="staffList" class="border rounded p-3" style="max-height: 300px; overflow-y: auto;">
                                    <p class="text-muted">Please select a meeting first.</p>
                                </div>
                            </div>
                        </div>
                    </form>
                `,
                size: 'lg',
                buttons: [
                    {
                        text: 'Assign Selected Members',
                        class: 'btn-primary',
                        onclick: 'submitBulkAssign()'
                    },
                    {
                        text: 'Cancel',
                        class: 'btn-secondary'
                    }
                ]
            });
        }

        // View meeting member details
        function viewMeetingMember(id) {
            const button = document.querySelector(`button[onclick="viewMeetingMember(${id})"]`);
            if (button) {
                modernUI.setButtonLoading(button, 'Loading...');
            }
            
            fetch(`/MeetingMembers/GetMeetingMemberDetails/${id}`)
                .then(response => response.json())
                .then(data => {
                    if (button) {
                        modernUI.resetButton(button);
                    }
                    
                    if (data.success) {
                        const member = data.data;
                        
                        // Helper function to safely get values
                        const safeValue = (value, defaultValue = 'N/A') => {
                            return (value !== null && value !== undefined && value !== '') ? value : defaultValue;
                        };
                        
                        modernUI.showModal({
                            title: `<i class="bi bi-person me-2"></i>Meeting Member Details`,
                            size: 'lg',
                            content: `
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title text-primary mb-3">
                                                    <i class="bi bi-person-badge me-1"></i>Member Information
                                                </h6>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Staff Name:</strong></div>
                                                    <div class="col-sm-7">${safeValue(member.staffName)}</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Department:</strong></div>
                                                    <div class="col-sm-7"><span class="badge bg-info">${safeValue(member.departmentName)}</span></div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Attendance:</strong></div>
                                                    <div class="col-sm-7">
                                                        <span class="badge bg-${member.isPresent ? 'success' : 'danger'}">
                                                            <i class="bi bi-${member.isPresent ? 'check-circle' : 'x-circle'} me-1"></i>
                                                            ${member.isPresent ? 'Present' : 'Absent'}
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-5"><strong>Remarks:</strong></div>
                                                    <div class="col-sm-7">${safeValue(member.remarks, 'No remarks')}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card border-0 bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title text-success mb-3">
                                                    <i class="bi bi-calendar-event me-1"></i>Meeting Information
                                                </h6>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Meeting:</strong></div>
                                                    <div class="col-sm-7">${safeValue(member.meetingDescription)}</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Date & Time:</strong></div>
                                                    <div class="col-sm-7">${safeValue(member.meetingDate)}</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Type:</strong></div>
                                                    <div class="col-sm-7"><span class="badge bg-secondary">${safeValue(member.meetingTypeName)}</span></div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Venue:</strong></div>
                                                    <div class="col-sm-7">${safeValue(member.venueName)}</div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col-sm-5"><strong>Created:</strong></div>
                                                    <div class="col-sm-7">${safeValue(member.created)}</div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-5"><strong>Modified:</strong></div>
                                                    <div class="col-sm-7">${safeValue(member.modified)}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `,
                            buttons: [
                                {
                                    text: 'Edit Member',
                                    class: 'btn-primary',
                                    icon: 'bi bi-pencil',
                                    onclick: `window.location.href='/MeetingMembers/MeetingMemberAddEdit/${id}'`
                                },
                                {
                                    text: 'Close',
                                    class: 'btn-secondary',
                                    onclick: 'modernUI.closeModal()'
                                }
                            ]
                        });
                    } else {
                        modernUI.showToast({
                            title: 'Error',
                            message: data.message || 'Failed to load meeting member details',
                            type: 'error'
                        });
                    }
                })
                .catch(error => {
                    if (button) {
                        modernUI.resetButton(button);
                    }
                    modernUI.showToast({
                        title: 'Error',
                        message: 'Failed to load meeting member details. Please try again.',
                        type: 'error'
                    });
                });
        }

        // Delete member
        function deleteMeetingMember(memberId) {
            modernUI.showConfirmation({
                title: 'Remove Member',
                message: `Are you sure you want to remove this member from the meeting?<br><small class="text-muted">This action cannot be undone.</small>`,
                confirmText: 'Remove Member',
                confirmClass: 'btn-danger',
                onConfirm: () => {
                    fetch('/MeetingMembers/Delete', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: `id=${memberId}`
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            modernUI.showToast({
                                title: 'Success',
                                message: data.message || 'Member removed successfully',
                                type: 'success'
                            });
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            modernUI.showToast({
                                title: 'Error',
                                message: data.message || 'Failed to remove member',
                                type: 'error'
                            });
                        }
                    })
                    .catch(error => {
                        modernUI.showToast({
                            title: 'Error',
                            message: 'Failed to remove member',
                            type: 'error'
                        });
                    });
                }
            });
        }

        // Initialize live search
        document.addEventListener('DOMContentLoaded', function() {
            modernUI.setupLiveSearch('input[name="search"]', '#memberTable');
        });
    </script>
}
