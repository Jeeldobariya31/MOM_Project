@model MOM.Models.DepartmentModel

@{
    ViewData["Title"] = Model.DepartmentID > 0 ? "Edit Department" : "Add Department";
    bool isEdit = Model.DepartmentID > 0;
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-building me-2"></i>@(isEdit ? "Edit Department" : "Add Department")</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="breadcrumb-item">Master</li>
                    <li class="breadcrumb-item">
                        <a asp-action="DepartmentList">Departments</a>
                    </li>
                    <li class="breadcrumb-item active">@(isEdit ? "Edit" : "Add")</li>
                </ol>
            </nav>
        </div>
        <a asp-action="DepartmentList" class="btn btn-light">
            <i class="bi bi-arrow-left me-1"></i>
            Back to List
        </a>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="section">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-hover">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <div class="avatar bg-primary me-3">
                            <i class="bi bi-building"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 text-white">
                                @(isEdit ? "Edit Department" : "Add New Department")
                            </h5>
                            <p class="mb-0 text-white-50 small">
                                @(isEdit ? "Update department information" : "Create a new department")
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <form asp-action="DepartmentAddEdit" method="post" id="departmentForm" novalidate>
                        @Html.AntiForgeryToken()
                        
                        <!-- Hidden ID for Edit -->
                        <input type="hidden" asp-for="DepartmentID" />
                        <input type="hidden" asp-for="Created" />

                        <div class="row">
                            <div class="col-md-8">
                                <!-- Department Name -->
                                <div class="mb-4">
                                    <label asp-for="DepartmentName" class="form-label">
                                        <i class="bi bi-building me-1"></i>
                                        Department Name 
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="DepartmentName"
                                           class="form-control"
                                           maxlength="100"
                                           placeholder="Enter department name"
                                           autocomplete="off" />
                                    <span asp-validation-for="DepartmentName" class="text-danger small"></span>
                                    <div class="form-text">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Enter a unique department name (2-100 characters)
                                    </div>
                                </div>
                            </div>

                            @if (isEdit)
                            {
                                <div class="col-md-4">
                                    <!-- Department Statistics -->
                                    <div class="card border-0 bg-light">
                                        <div class="card-body">
                                            <h6 class="card-title text-primary">
                                                <i class="bi bi-graph-up me-1"></i>
                                                Statistics
                                            </h6>
                                            <div class="row text-center">
                                                <div class="col-6">
                                                    <div class="border-end">
                                                        <h4 class="text-primary mb-0">@Model.StaffCount</h4>
                                                        <small class="text-muted">Staff</small>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <h4 class="text-success mb-0">@Model.MeetingCount</h4>
                                                    <small class="text-muted">Meetings</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Audit Information -->
                                    <div class="card border-0 bg-light mt-3">
                                        <div class="card-body">
                                            <h6 class="card-title text-secondary">
                                                <i class="bi bi-clock-history me-1"></i>
                                                Audit Trail
                                            </h6>
                                            <div class="small">
                                                <div class="mb-2">
                                                    <strong>Created:</strong><br>
                                                    <span class="text-muted">@Model.Created.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                </div>
                                                <div>
                                                    <strong>Modified:</strong><br>
                                                    <span class="text-muted">@Model.Modified.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Form Actions -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <button type="button" class="btn btn-outline-secondary" onclick="resetForm()">
                                            <i class="bi bi-arrow-clockwise me-1"></i>
                                            Reset
                                        </button>
                                    </div>
                                    <div>
                                        <button type="submit" class="btn btn-primary" id="submitBtn">
                                            <i class="bi bi-@(isEdit ? "check" : "plus")-lg me-1"></i>
                                            @(isEdit ? "Update Department" : "Save Department")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            @if (isEdit && (Model.StaffCount > 0 || Model.MeetingCount > 0))
            {
                <!-- Related Information -->
                <div class="card mt-4 shadow-hover">
                    <div class="card-header">
                        <h6 class="mb-0 text-white">
                            <i class="bi bi-link-45deg me-1"></i>
                            Related Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @if (Model.StaffCount > 0)
                            {
                                <div class="col-md-6">
                                    <div class="card border-0 bg-primary bg-opacity-10">
                                        <div class="card-body d-flex align-items-center">
                                            <div class="avatar bg-primary me-3">
                                                <i class="bi bi-people-fill"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0">@Model.StaffCount Staff Members</h6>
                                                <small class="text-muted">Associated with this department</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (Model.MeetingCount > 0)
                            {
                                <div class="col-md-6">
                                    <div class="card border-0 bg-success bg-opacity-10">
                                        <div class="card-body d-flex align-items-center">
                                            <div class="avatar bg-success me-3">
                                                <i class="bi bi-calendar-event-fill"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0">@Model.MeetingCount Meetings</h6>
                                                <small class="text-muted">Associated with this department</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="alert alert-warning mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <strong>Note:</strong> This department cannot be deleted as it has associated records.
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Guidelines Sidebar -->
        <div class="col-lg-4">
            <div class="card shadow-hover">
                <div class="card-header">
                    <h6 class="mb-0 text-white">
                        <i class="bi bi-info-circle me-1"></i>Department Guidelines
                    </h6>
                </div>
                <div class="card-body">
                    <div class="guidelines-panel tips">
                        <div class="guidelines-header">
                            <i class="bi bi-lightbulb"></i>
                            Best Practices
                        </div>
                        <div class="guidelines-content">
                            <ul>
                                <li>Use clear, descriptive department names</li>
                                <li>Keep names concise but meaningful</li>
                                <li>Avoid special characters except &, ., and -</li>
                                <li>Consider organizational hierarchy</li>
                                <li>Use consistent naming conventions</li>
                            </ul>
                        </div>
                    </div>

                    <div class="guidelines-panel warning">
                        <div class="guidelines-header">
                            <i class="bi bi-exclamation-triangle"></i>
                            Important Notes
                        </div>
                        <div class="guidelines-content">
                            <ul>
                                <li><strong>Department names must be unique</strong></li>
                                <li>Cannot delete departments with staff or meetings</li>
                                <li>Changes affect all associated records</li>
                                <li>Name length: 2-100 characters</li>
                            </ul>
                        </div>
                    </div>

                    @if (isEdit)
                    {
                        <div class="info-card">
                            <h6 class="info-card-title">
                                <i class="bi bi-clock-history me-1"></i>Department History
                            </h6>
                            <div class="info-card-content">
                                <div class="info-item">
                                    <span class="info-label">Created:</span>
                                    <span class="info-value">@Model.Created.ToString("MMM dd, yyyy hh:mm tt")</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">Last Modified:</span>
                                    <span class="info-value">@Model.Modified.ToString("MMM dd, yyyy hh:mm tt")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow-hover">
                <div class="card-header">
                    <h6 class="mb-0 text-white">
                        <i class="bi bi-lightning me-1"></i>Quick Actions
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="DepartmentList" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-list me-1"></i>View All Departments
                        </a>
                        <a asp-controller="Staff" asp-action="StaffList" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-people me-1"></i>Manage Staff
                        </a>
                        @if (isEdit)
                        {
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="viewDepartmentStaff()">
                                <i class="bi bi-person-lines-fill me-1"></i>View Department Staff
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize modern form validation
            modernUI.initializeFormValidation('#departmentForm', {
                'DepartmentName': {
                    required: true,
                    minLength: 2,
                    maxLength: 100,
                    pattern: /^[a-zA-Z0-9\s&.-]+$/,
                    messages: {
                        required: 'Department name is required',
                        minLength: 'Name must be at least 2 characters',
                        maxLength: 'Name cannot exceed 100 characters',
                        pattern: 'Only letters, numbers, spaces, &, ., and - are allowed'
                    }
                },
                'Remarks': {
                    required: true,
                    minLength: 5,
                    maxLength: 100,
                    messages: {
                        required: 'Remarks are required',
                        minLength: 'Remarks must be at least 5 characters',
                        maxLength: 'Remarks cannot exceed 100 characters'
                    }
                }
            });

            // Form submission with loading state
            const form = document.getElementById('departmentForm');
            const submitBtn = document.getElementById('submitBtn');
            
            form.addEventListener('submit', function(e) {
                if (!modernUI.validateForm('#departmentForm')) {
                    e.preventDefault();
                    return false;
                }
                
                // Show loading state
                modernUI.setButtonLoading(submitBtn, 'Saving...');
            });

            // Character counter for remarks
            const remarksField = document.querySelector('textarea[name="Remarks"]');
            if (remarksField) {
                modernUI.initializeCharacterCounter(remarksField, 100);
            }
        });

        function resetForm() {
            modernUI.showConfirmation({
                title: 'Reset Form',
                message: 'Are you sure you want to reset the form? All changes will be lost.',
                confirmText: 'Reset',
                confirmClass: 'btn-warning',
                onConfirm: () => {
                    document.getElementById('departmentForm').reset();
                    modernUI.clearFormValidation('#departmentForm');
                    modernUI.showToast('Form has been reset', 'info');
                }
            });
        }

        // Quick action functions
        function viewDepartmentStaff() {
            @if (isEdit)
            {
                <text>
                window.location.href = '/Staff/StaffList?departmentFilter=@Model.DepartmentID';
                </text>
            }
            else
            {
                <text>
                modernUI.showToast('Please save the department first', 'info');
                </text>
            }
        }

        // Guidelines are now permanently visible with CSS !important rules
        // No JavaScript hiding of any alerts - guidelines stay visible forever
    </script>
    
    <!-- Enables client-side validation -->
    <partial name="_ValidationScriptsPartial" />
}
